{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "TrueForge",
  "image": "oci.trueforge.org/containerforge/devcontainer:4.1.1@sha256:02269164d84ac536ce072b6ac0da070c9471de3b41ef051dae75311037671b2f",
  "initializeCommand": "mkdir -p ${localEnv:HOME}${localEnv:USERPROFILE}/.claude",
  "postCreateCommand": "if [ -f package.json ]; then npm install; fi",
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/config/.claude,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/config/.claude"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "albert.TabOut",
        "mikestead.dotenv",
        "mitchdenny.ecdc",
        "signageos.signageos-vscode-sops",
        "EditorConfig.editorconfig",
        "PKief.material-icon-theme",
        "usernamehw.errorlens",
        "redhat.vscode-yaml",
        "weaveworks.vscode-gitops-tools",
        "Tim-Koehler.helm-intellisense",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "sandipchitale.vscode-kubernetes-helm-extras",
        "VadzimNestsiarenka.helm-template-preview-and-more",
        "karyan40024.helmix",
        "eamodio.gitlens",
        "formulahendry.code-runner",
        "streetsidesoftware.code-spell-checker",
        "mhutchie.git-graph",
        "yzhang.markdown-all-in-one",
        "searKing.preview-vscode",
        "DavidAnson.vscode-markdownlint",
        "Anthropic.claude-code",
        "golang.go",
        "mrmlnc.vscode-duplicate",
        "IgorSbitnev.error-gutters",
        "vivaldy22.go-auto-struct-tag",
        "msyrus.go-doc",
        "766b.go-outliner",
        "premparihar.gotestexplorer",
        "zxh404.vscode-proto3",
        "ms-azuretools.vscode-docker",
        "hashicorp.hcl",
        "exiasr.hadolint",
        "joao-peterson.gotag",
        "timonwong.shellcheck",
        "Codium.codium",
        "GitHub.copilot",
        "SimonSiefke.svg-preview",
        "ecmel.vscode-html-css",
        "hossaini.bootstrap-intellisense",
        "astro-build.astro-vscode"
      ]
    }
  }
}
