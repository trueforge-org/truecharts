{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extend 
    "config:recommended",
    "github>trueforge-org/renovate-config",
    "github>trueforge-org/renovate-config:autoMergeLabels.json5"
  ],
  "packageRules": [
    {
      "description": "Ignore unavailable MinIO Docker Hub image",
      "matchDatasources": ["docker"],
      "matchFileNames": ["charts/stable/minio/values.yaml"],
      "matchPackageNames": [
        "docker.io/minio/minio",
        "minio/minio"
      ],
      "enabled": false
    }
  ]
  // "registryAliases": {
  //   "registry-1.docker.io": "http://192.168.10.208:5000",
  //   "docker.io": "http://192.168.10.208:5000"
  // }
}
