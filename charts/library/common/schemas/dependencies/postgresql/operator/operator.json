{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cluster": {
      "allOf": [
        {
          "$ref": "cluster.json"
        }
      ],
      "description": "Configuration of the CNPG cluster."
    },
    "hibernate": {
      "type": "boolean",
      "description": "Puts the CNPG cluster in hibernation mode.",
      "default": false
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Additional labels for all CNPG objects.",
      "default": {}
    },
    "annotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Additional annotations for all CNPG objects.",
      "default": {}
    },
    "type": {
      "type": "string",
      "enum": [
        "postgres",
        "postgis",
        "vectors",
        "vectorchord"
      ],
      "description": "Type of the CNPG database.",
      "default": "postgres"
    },
    "pgVersion": {
      "type": "integer",
      "enum": [
        15,
        16,
        17,
        18
      ],
      "description": "Version of PostgreSQL to use, changes the cluster naming scheme. Without a value, `global.fallbackDefaults.cnpg.pgVersion` is used, and `type: vectors` uses `16` as it has no image for PostgreSQL 18. It only applies to `operator` mode, and is ignored in `standalone` mode.\n\nIt only applies to `operator` mode, and is ignored in `standalone` mode.\n\nWithout a value, `global.fallbackDefaults.cnpg.pgVersion` is used. `type: vectors` has no image for PostgreSQL 18, so without a value it uses `16`.\n\n:::caution[Changing the version of an existing cluster]\n\nCloudNativePG upgrades an existing cluster in place when its major version changes, with `pg_upgrade`. This also happens when a cluster has no `pgVersion` set and the default changes, so **set `pgVersion` to keep a cluster on its current version**.\n\n- Take a full backup first, and a new one afterwards. Older backups can't be used for point-in-time recovery across major versions.\n- All instances are stopped during the upgrade, and replicas are cloned again afterwards.\n- It needs CloudNativePG 1.26 or newer.\n- CloudNativePG only supports this between images on the same OS distribution. The images of this version of common moved to Debian 13, so a cluster on an older image should stay on its major version through that change, and upgrade afterwards.\n- Check that the extensions of the cluster can be upgraded, such as PostGIS or VectorChord.\n- If the upgrade fails, set `pgVersion` back to the previous version. CloudNativePG then starts the cluster on that version again.\n- Run `ANALYZE` afterwards, as `pg_upgrade` does not keep the statistics.\n\n:::",
      "default": 18
    },
    "mode": {
      "type": "string",
      "enum": [
        "standalone",
        "recovery"
      ],
      "description": "Cluster mode of operation. `standalone` creates a new or updates an existing CNPG cluster, `recovery` creates a cluster from a backup or object store. Not to be confused with `dependencies.postgresql.mode`.",
      "default": "standalone"
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enablePodMonitor": {
          "type": "boolean",
          "description": "Configuration for `dependencies.postgresql.operator.monitoring.enablePodMonitor`."
        },
        "disableDefaultQueries": {
          "type": "boolean",
          "description": "Configuration for `dependencies.postgresql.operator.monitoring.disableDefaultQueries`."
        },
        "customQueries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.name`."
              },
              "key": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.key`."
              },
              "query": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.query`."
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "datname": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.datname.description`."
                        },
                        "usage": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.datname.usage`."
                        }
                      },
                      "additionalProperties": false,
                      "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.datname`."
                    },
                    "size_bytes": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.size_bytes.description`."
                        },
                        "usage": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.size_bytes.usage`."
                        }
                      },
                      "additionalProperties": false,
                      "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.size_bytes`."
                    }
                  },
                  "additionalProperties": true,
                  "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item`."
                },
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics`."
              },
              "expandObjectName": {
                "type": [
                  "boolean",
                  "string"
                ],
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.expandObjectName`."
              }
            },
            "additionalProperties": false,
            "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item`."
          },
          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries`."
        }
      },
      "additionalProperties": false,
      "description": "Configuration for `dependencies.postgresql.operator.monitoring`."
    },
    "recovery": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "description": "Recovery method of the CNPG cluster, such as `object_store`.",
          "default": "object_store"
        },
        "serverName": {
          "type": "string",
          "description": "Overrides the `serverName` of the recovery object store.",
          "default": ""
        },
        "pitrTarget": {
          "type": "object",
          "properties": {
            "time": {
              "type": "string",
              "description": "Point in time recovery target time.",
              "default": ""
            }
          },
          "additionalProperties": false,
          "description": "Point in time recovery target.",
          "default": {
            "time": ""
          }
        },
        "destinationPath": {
          "type": "string",
          "description": "Destination path of the object store to recover from.",
          "default": ""
        },
        "credentials": {
          "type": "string",
          "description": "Name of the credentials in `.Values.credentials` for the object store to recover from."
        },
        "revision": {
          "type": "string",
          "description": "Revision appended to the `serverName` of the recovery archive, so restore and backup use different archives. Must be a string."
        },
        "retentionPolicy": {
          "type": "string",
          "description": "Retention policy of the recovery archive. The chart does not read this key yet, so it has no effect."
        },
        "instanceSidecarConfiguration": {
          "allOf": [
            {
              "$ref": "instanceSidecarConfiguration.json"
            }
          ],
          "description": "Configuration for `dependencies.postgresql.operator.recovery.instanceSidecarConfiguration`."
        }
      },
      "additionalProperties": false,
      "description": "Configuration for `dependencies.postgresql.operator.recovery`."
    },
    "backups": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Enables the backups of the CNPG cluster.",
          "default": false
        },
        "encryption": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "string"
              ],
              "description": "Encrypts the backups with AES256 when enabled.",
              "default": false
            }
          },
          "additionalProperties": false,
          "description": "Encryption of the backups.",
          "default": {
            "enabled": false
          }
        },
        "serverName": {
          "type": "string",
          "description": "Overrides the `serverName` in the object store of the backups.",
          "default": ""
        },
        "destinationPath": {
          "type": "string",
          "description": "Destination path of the object store for the backups.",
          "default": ""
        },
        "target": {
          "type": "string",
          "description": "Target of the backups, `prefer-standby` or `primary`. Empty uses the default, `prefer-standby`.",
          "default": ""
        },
        "credentials": {
          "type": "string",
          "description": "Name of the credentials in `.Values.credentials` for the object store of the backups.",
          "default": ""
        },
        "scheduledBackups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.name`."
              },
              "schedule": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.schedule`."
              },
              "backupOwnerReference": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.backupOwnerReference`."
              },
              "immediate": {
                "type": "boolean",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.immediate`."
              },
              "suspend": {
                "type": "boolean",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.suspend`."
              }
            },
            "additionalProperties": false,
            "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item`."
          },
          "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups`.",
          "default": [
            {
              "name": "daily-backup",
              "schedule": "0 0 0 * * *",
              "backupOwnerReference": "self",
              "immediate": true,
              "suspend": false
            }
          ]
        },
        "retentionPolicy": {
          "type": "string",
          "description": "Retention policy of the backups, for example `30d`.",
          "default": "30d"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional labels for the backup objects of the CNPG cluster, merged with the root `labels`."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Additional annotations for the backup objects of the CNPG cluster, merged with the root `annotations`."
        },
        "compression": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Set to `false` to disable the `bzip2` compression of the backups."
            }
          },
          "additionalProperties": false,
          "description": "Compression of the backups."
        },
        "revision": {
          "type": "string",
          "description": "Revision appended to the `serverName` of the backup archive, so restore and backup use different archives. Must be a string. Required when `cluster.skipEmptyWalArchiveCheck` is false and both use the same archive."
        },
        "jobs": {
          "type": "integer",
          "description": "Number of parallel jobs used to upload the backups. Uses `2` when unset."
        },
        "manualBackups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups.$item.name`."
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Additional labels for this manual backup, merged with `backups.labels`."
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Additional annotations for this manual backup, merged with `backups.annotations`."
              }
            },
            "additionalProperties": false,
            "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups.$item`."
          },
          "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups`.",
          "default": []
        },
        "instanceSidecarConfiguration": {
          "allOf": [
            {
              "$ref": "instanceSidecarConfiguration.json"
            }
          ],
          "description": "Configuration for `dependencies.postgresql.operator.backups.instanceSidecarConfiguration`."
        }
      },
      "additionalProperties": false,
      "description": "Configuration for `dependencies.postgresql.operator.backups`."
    },
    "pooler": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "string"
          ],
          "default": false,
          "description": "Configuration for `dependencies.postgresql.operator.pooler.enabled`."
        },
        "createRO": {
          "type": "boolean",
          "default": false,
          "description": "Configuration for `dependencies.postgresql.operator.pooler.createRO`."
        },
        "poolMode": {
          "type": "string",
          "default": "session",
          "description": "Configuration for `dependencies.postgresql.operator.pooler.poolMode`."
        },
        "instances": {
          "type": "integer",
          "default": 2,
          "description": "Configuration for `dependencies.postgresql.operator.pooler.instances`."
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Configuration for `dependencies.postgresql.operator.pooler.parameters`."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Configuration for `dependencies.postgresql.operator.pooler.labels`."
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Configuration for `dependencies.postgresql.operator.pooler.annotations`."
        }
      },
      "additionalProperties": false,
      "description": "Configuration for `dependencies.postgresql.operator.pooler`."
    }
  },
  "additionalProperties": false,
  "description": "Settings of the CloudNativePG cluster that provides the `postgresql` dependency in `operator` mode. Never merged into the chart values."
}
