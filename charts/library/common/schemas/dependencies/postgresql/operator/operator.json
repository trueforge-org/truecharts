{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cluster": {
      "allOf": [
        {
          "$ref": "cluster.json"
        }
      ],
      "description": "Configuration of the CNPG cluster."
    },
    "hibernate": {
      "type": "boolean",
      "description": "Puts the CNPG cluster in hibernation mode.",
      "default": false
    },
    "labels": {
      "allOf": [
        {
          "$ref": "../../../special/labels.json"
        }
      ],
      "description": "Additional labels for all CNPG objects.",
      "type": [
        "object",
        "string"
      ],
      "default": {}
    },
    "annotations": {
      "type": [
        "object",
        "string"
      ],
      "properties": {},
      "additionalProperties": true,
      "description": "Additional annotations for all CNPG objects.",
      "default": {}
    },
    "type": {
      "type": "string",
      "enum": [
        "postgres",
        "postgis",
        "timescaledb",
        "vectors",
        "vectorchord"
      ],
      "description": "Type of the CNPG database.",
      "default": "postgres"
    },
    "pgVersion": {
      "type": "integer",
      "enum": [
        15,
        16,
        17,
        18
      ],
      "description": "Version of PostgreSQL to use, changes the cluster naming scheme. Without a value, `global.fallbackDefaults.cnpg.pgVersion` is used, and `type: vectors` uses `16` as it has no image for PostgreSQL 18.",
      "default": 18
    },
    "mode": {
      "type": "string",
      "enum": [
        "standalone",
        "recovery"
      ],
      "description": "Cluster mode of operation. `standalone` creates a new or updates an existing CNPG cluster, `recovery` creates a cluster from a backup or object store. Not to be confused with `dependencies.postgresql.mode`.",
      "default": "standalone"
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enablePodMonitor": {
          "type": "boolean",
          "description": "Configuration for `dependencies.postgresql.operator.monitoring.enablePodMonitor`."
        },
        "disableDefaultQueries": {
          "type": "boolean",
          "description": "Configuration for `dependencies.postgresql.operator.monitoring.disableDefaultQueries`."
        },
        "customQueries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.name`."
              },
              "key": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.key`."
              },
              "query": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.query`."
              },
              "metrics": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "datname": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.datname.description`."
                        },
                        "usage": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.datname.usage`."
                        }
                      },
                      "additionalProperties": true,
                      "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.datname`."
                    },
                    "size_bytes": {
                      "type": "object",
                      "properties": {
                        "description": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.size_bytes.description`."
                        },
                        "usage": {
                          "type": "string",
                          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.size_bytes.usage`."
                        }
                      },
                      "additionalProperties": true,
                      "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item.size_bytes`."
                    }
                  },
                  "additionalProperties": true,
                  "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics.$item`."
                },
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.metrics`."
              },
              "expandObjectName": {
                "type": [
                  "boolean",
                  "string"
                ],
                "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item.expandObjectName`."
              }
            },
            "additionalProperties": true,
            "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries.$item`."
          },
          "description": "Configuration for `dependencies.postgresql.operator.monitoring.customQueries`."
        }
      },
      "additionalProperties": true,
      "description": "Configuration for `dependencies.postgresql.operator.monitoring`."
    },
    "recovery": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.recovery.method`."
        },
        "serverName": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.recovery.serverName`."
        },
        "pitrTarget": {
          "type": "object",
          "properties": {
            "time": {
              "type": "string",
              "description": "Configuration for `dependencies.postgresql.operator.recovery.pitrTarget.time`."
            }
          },
          "additionalProperties": true,
          "description": "Configuration for `dependencies.postgresql.operator.recovery.pitrTarget`."
        },
        "destinationPath": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.recovery.destinationPath`."
        },
        "instanceSidecarConfiguration": {
          "type": "object",
          "additionalProperties": true,
          "description": "Configuration for `dependencies.postgresql.operator.recovery.instanceSidecarConfiguration`."
        }
      },
      "additionalProperties": true,
      "description": "Configuration for `dependencies.postgresql.operator.recovery`."
    },
    "backups": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Configuration for `dependencies.postgresql.operator.backups.enabled`."
        },
        "encryption": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": [
                "boolean",
                "string"
              ],
              "description": "Configuration for `dependencies.postgresql.operator.backups.encryption.enabled`."
            }
          },
          "additionalProperties": true,
          "description": "Configuration for `dependencies.postgresql.operator.backups.encryption`."
        },
        "serverName": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.backups.serverName`."
        },
        "destinationPath": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.backups.destinationPath`."
        },
        "target": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.backups.target`."
        },
        "credentials": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.backups.credentials`."
        },
        "scheduledBackups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.name`."
              },
              "schedule": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.schedule`."
              },
              "backupOwnerReference": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.backupOwnerReference`."
              },
              "immediate": {
                "type": "boolean",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.immediate`."
              },
              "suspend": {
                "type": "boolean",
                "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item.suspend`."
              }
            },
            "additionalProperties": true,
            "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups.$item`."
          },
          "description": "Configuration for `dependencies.postgresql.operator.backups.scheduledBackups`."
        },
        "retentionPolicy": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.backups.retentionPolicy`."
        },
        "manualBackups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups.$item.name`."
              },
              "labels": {
                "allOf": [
                  {
                    "$ref": "../../../special/labels.json"
                  }
                ],
                "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups.$item.labels`."
              },
              "annotations": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups.$item.annotations`."
              }
            },
            "additionalProperties": true,
            "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups.$item`."
          },
          "description": "Configuration for `dependencies.postgresql.operator.backups.manualBackups`."
        },
        "instanceSidecarConfiguration": {
          "type": "object",
          "additionalProperties": true,
          "description": "Configuration for `dependencies.postgresql.operator.backups.instanceSidecarConfiguration`."
        }
      },
      "additionalProperties": true,
      "description": "Configuration for `dependencies.postgresql.operator.backups`."
    },
    "pooler": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Configuration for `dependencies.postgresql.operator.pooler.enabled`."
        },
        "createRO": {
          "type": "boolean",
          "description": "Configuration for `dependencies.postgresql.operator.pooler.createRO`."
        },
        "poolMode": {
          "type": "string",
          "description": "Configuration for `dependencies.postgresql.operator.pooler.poolMode`."
        },
        "instances": {
          "type": "integer",
          "description": "Configuration for `dependencies.postgresql.operator.pooler.instances`."
        },
        "labels": {
          "allOf": [
            {
              "$ref": "../../../special/labels.json"
            }
          ],
          "description": "Configuration for `dependencies.postgresql.operator.pooler.labels`."
        },
        "annotations": {
          "type": "object",
          "properties": {},
          "additionalProperties": true,
          "description": "Configuration for `dependencies.postgresql.operator.pooler.annotations`."
        }
      },
      "additionalProperties": true,
      "description": "Configuration for `dependencies.postgresql.operator.pooler`."
    }
  },
  "additionalProperties": true,
  "description": "Settings of the CloudNativePG cluster that provides the `postgresql` dependency in `operator` mode. Never merged into the chart values."
}
