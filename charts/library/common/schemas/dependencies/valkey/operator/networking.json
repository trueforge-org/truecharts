{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Network settings of the valkey cluster.",
  "properties": {
    "clusterDomain": {
      "type": "string",
      "default": "",
      "description": "Domain of the Kubernetes cluster. The operator uses `cluster.local` when unset."
    },
    "discovery": {
      "allOf": [
        {
          "$ref": "networking/discovery.json"
        }
      ],
      "default": {
        "preferredEndpointType": ""
      },
      "description": "Discovery (in-cluster announce) of the nodes."
    }
  },
  "additionalProperties": false
}
