{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Metrics exporter sidecar that runs in every valkey pod.",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the exporter sidecar runs."
    },
    "imageSelector": {
      "type": "string",
      "default": "valkeyExporterImage",
      "description": "Image of the exporter, the name of an image on the root of the values."
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Command-line arguments of the exporter."
    },
    "resources": {
      "allOf": [
        {
          "$ref": "resourceRequirements.json"
        }
      ],
      "default": {},
      "description": "Resources of the exporter container."
    },
    "securityContext": {
      "allOf": [
        {
          "$ref": "securityContext.json"
        }
      ],
      "default": {},
      "description": "Security context of the exporter container."
    }
  },
  "additionalProperties": false
}
