{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 15,
      "description": "Name of the port, can be referenced by probes. At most 15 characters."
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Port the container listens on."
    },
    "hostPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Port on the host that is mapped to the `containerPort`."
    },
    "protocol": {
      "type": "string",
      "enum": [
        "TCP",
        "UDP",
        "SCTP"
      ],
      "description": "Protocol of the port."
    },
    "hostIP": {
      "type": "string",
      "description": "Host IP the `hostPort` is bound to."
    }
  },
  "required": [
    "containerPort"
  ],
  "additionalProperties": false,
  "description": "Port of the container."
}
