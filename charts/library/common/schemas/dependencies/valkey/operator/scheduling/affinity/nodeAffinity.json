{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "requiredDuringSchedulingIgnoredDuringExecution": {
      "type": "object",
      "properties": {
        "nodeSelectorTerms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "nodeSelectorTerm.json"
          },
          "description": "Terms, one of which the node must match."
        }
      },
      "required": [
        "nodeSelectorTerms"
      ],
      "additionalProperties": false,
      "description": "Terms the node must match."
    },
    "preferredDuringSchedulingIgnoredDuringExecution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Weight of the term, from 1 to 100."
          },
          "preference": {
            "allOf": [
              {
                "$ref": "nodeSelectorTerm.json"
              }
            ],
            "description": "Term the node should match."
          }
        },
        "required": [
          "weight",
          "preference"
        ],
        "additionalProperties": false
      },
      "description": "Terms the node should match."
    }
  },
  "additionalProperties": false
}
