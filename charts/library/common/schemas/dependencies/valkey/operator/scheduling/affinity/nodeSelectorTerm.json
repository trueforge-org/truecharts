{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "A node selector term: requirements on the labels or fields of a node.",
  "properties": {
    "matchExpressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Label key the requirement applies to."
          },
          "operator": {
            "type": "string",
            "enum": [
              "In",
              "NotIn",
              "Exists",
              "DoesNotExist",
              "Gt",
              "Lt"
            ],
            "description": "Operator of the requirement."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Values of the label, with `In`, `NotIn`, `Gt` and `Lt`."
          }
        },
        "required": [
          "key",
          "operator"
        ],
        "additionalProperties": false
      },
      "description": "Requirements on the labels of the node."
    },
    "matchFields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Field the requirement applies to, for example `metadata.name`."
          },
          "operator": {
            "type": "string",
            "enum": [
              "In",
              "NotIn",
              "Exists",
              "DoesNotExist",
              "Gt",
              "Lt"
            ],
            "description": "Operator of the requirement."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Values of the field, with `In`, `NotIn`, `Gt` and `Lt`."
          }
        },
        "required": [
          "key",
          "operator"
        ],
        "additionalProperties": false
      },
      "description": "Requirements on the fields of the node."
    }
  },
  "additionalProperties": false
}
