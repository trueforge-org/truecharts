{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "matchLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Match pods with all of these labels."
    },
    "matchExpressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Label key the expression applies to."
          },
          "operator": {
            "type": "string",
            "enum": [
              "In",
              "NotIn",
              "Exists",
              "DoesNotExist"
            ],
            "description": "Operator: `In`, `NotIn`, `Exists` or `DoesNotExist`."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Values of the label."
          }
        },
        "required": [
          "key",
          "operator"
        ],
        "additionalProperties": false
      },
      "description": "Match pods using label expressions."
    }
  },
  "additionalProperties": false,
  "description": "Kubernetes label selector."
}
