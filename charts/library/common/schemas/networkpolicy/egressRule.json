{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "to": {
      "type": "array",
      "items": {
        "$ref": "peer.json"
      },
      "description": "Peers that may receive traffic."
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "port.json"
      },
      "description": "Ports allowed by this rule."
    },
    "toEntities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Cilium only: entities (for example `world`, `cluster`, `host` or `all`) allowed to receive traffic. Ignored for Kubernetes NetworkPolicies."
    }
  },
  "additionalProperties": false,
  "description": "An egress rule."
}
