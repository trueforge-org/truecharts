{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Create this NetworkPolicy.",
      "default": false
    },
    "primary": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Mark this as the primary NetworkPolicy.",
      "default": false
    },
    "expandObjectName": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Expand the object name.",
      "default": false
    },
    "namespace": {
      "$ref": "../special/namespaces.json",
      "description": "Namespace for this NetworkPolicy.",
      "default": ""
    },
    "labels": {
      "allOf": [
        {
          "$ref": "../special/labels.json"
        }
      ],
      "description": "Additional labels for this NetworkPolicy.",
      "default": {}
    },
    "annotations": {
      "type": [
        "object",
        "string"
      ],
      "additionalProperties": true,
      "description": "Additional annotations for this NetworkPolicy.",
      "default": {}
    },
    "type": {
      "type": "string",
      "oneOf": [
        {
          "enum": [
            "kubernetes",
            "cilium"
          ]
        },
        {
          "type": "string",
          "pattern": "^\\{\\{.*\\}\\}$"
        }
      ],
      "description": "Type of policy to create. `kubernetes` creates a NetworkPolicy, `cilium` creates a CiliumNetworkPolicy and requires the Cilium CRDs",
      "default": "kubernetes"
    },
    "clusterwide": {
      "type": [
        "boolean",
        "string"
      ],
      "properties": {},
      "additionalProperties": true,
      "description": "Cilium only. Create a CiliumClusterwideNetworkPolicy instead of a CiliumNetworkPolicy, chart based selectors are pinned to the namespace of the chart",
      "default": false
    },
    "description": {
      "type": "string",
      "description": "Cilium only. Free form description of the policy, supports Helm `tpl`",
      "default": ""
    },
    "podSelector": {
      "$ref": "podSelector.json",
      "description": "Custom Kubernetes label selector for pods to which this policy applies."
    },
    "targetSelector": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      },
      "description": "Target one or more workloads from this chart by name.",
      "default": ""
    },
    "targetSelectorRegex": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      },
      "properties": {},
      "additionalProperties": true,
      "description": "Target workloads from this chart whose names match one or more regular expressions",
      "default": ""
    },
    "targetAllPods": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Target all pods in the namespace.",
      "default": false
    },
    "endpointSelector": {
      "type": [
        "object",
        "string"
      ],
      "properties": {
        "matchLabels": {
          "type": "object",
          "properties": {},
          "additionalProperties": true,
          "description": "Match endpoints by labels"
        },
        "matchExpressions": {
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "description": "Match endpoints by label expressions"
        }
      },
      "additionalProperties": true,
      "description": "Cilium only. Select the endpoints to which this policy applies, supports Helm `tpl`"
    },
    "nodeSelector": {
      "type": [
        "object",
        "string"
      ],
      "properties": {
        "matchLabels": {
          "type": "object",
          "properties": {},
          "additionalProperties": true,
          "description": "Match nodes by labels"
        },
        "matchExpressions": {
          "type": [
            "array",
            "string"
          ],
          "items": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "description": "Match nodes by label expressions"
        }
      },
      "additionalProperties": true,
      "description": "Cilium only. Host policy, select the nodes to which this policy applies instead of pods. Requires `clusterwide: true`, supports Helm `tpl`"
    },
    "policyTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Ingress",
          "Egress"
        ]
      },
      "description": "Policy types. When omitted, types are inferred from the configured rules."
    },
    "enableDefaultDeny": {
      "type": "object",
      "properties": {
        "ingress": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Put the selected endpoints in ingress default deny mode"
        },
        "egress": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Put the selected endpoints in egress default deny mode"
        }
      },
      "additionalProperties": true,
      "description": "Cilium only. Control whether the policy puts the selected endpoints in default deny mode"
    },
    "ingress": {
      "type": "array",
      "items": {
        "$ref": "ingressRule.json"
      },
      "description": "Ingress rules.",
      "default": []
    },
    "ingressDeny": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": true,
        "description": "Configuration for `$name.ingressDeny.$item`."
      },
      "description": "Cilium only. List of ingress deny rules, these take precedence over allow rules, supports Helm `tpl`",
      "default": []
    },
    "egress": {
      "type": "array",
      "items": {
        "$ref": "egressRule.json"
      },
      "description": "Egress rules.",
      "default": []
    },
    "egressDeny": {
      "type": [
        "array",
        "string"
      ],
      "items": {
        "type": "object",
        "properties": {},
        "additionalProperties": true,
        "description": "Configuration for `$name.egressDeny.$item`."
      },
      "description": "Cilium only. List of egress deny rules, these take precedence over allow rules, supports Helm `tpl`",
      "default": []
    }
  },
  "additionalProperties": true,
  "description": "Configuration for a NetworkPolicy."
}
