{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "podSelector": {
      "$ref": "labelSelector.json",
      "description": "Select pods in the policy namespace."
    },
    "namespaceSelector": {
      "$ref": "labelSelector.json",
      "description": "Select namespaces by labels."
    },
    "ipBlock": {
      "type": "object",
      "properties": {
        "cidr": {
          "type": "string",
          "description": "CIDR range to match."
        },
        "except": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "A CIDR range, eg `10.0.1.0/24`."
          },
          "description": "CIDR ranges excluded from the block."
        }
      },
      "required": [
        "cidr"
      ],
      "additionalProperties": false,
      "description": "A CIDR, with exceptions."
    }
  },
  "additionalProperties": false,
  "description": "A peer allowed by a NetworkPolicy rule."
}
