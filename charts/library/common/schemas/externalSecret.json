{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enables or Disables the ExternalSecret",
        "default": false
      },
      "expandObjectName": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Prefix the object name with the chart fullname",
        "default": true
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": ""
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for ExternalSecret",
        "default": {}
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "special/annotations.json"
          }
        ],
        "description": "Additional annotations for ExternalSecret",
        "default": {}
      },
      "refreshInterval": {
        "type": [
          "null",
          "string"
        ],
        "description": "How often the data is synced from the provider, supports Helm `tpl`. Uses the External Secrets Operator default when empty."
      },
      "refreshPolicy": {
        "type": [
          "null",
          "string"
        ],
        "enum": [
          null,
          "",
          "CreatedOnce",
          "Periodic",
          "OnChange"
        ],
        "description": "When the data is synced from the provider."
      },
      "secretStoreRef": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the SecretStore or ClusterSecretStore, supports Helm `tpl`.",
            "x-helm-tpl": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "SecretStore",
              "ClusterSecretStore"
            ],
            "description": "Kind of the store the data is fetched from.",
            "default": "SecretStore"
          }
        },
        "additionalProperties": false,
        "description": "The store the data is fetched from."
      },
      "target": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name of the Secret created by the External Secrets Operator, supports Helm `tpl`. Defaults to the name of the ExternalSecret.",
            "x-helm-tpl": true
          },
          "creationPolicy": {
            "type": "string",
            "enum": [
              "Owner",
              "Orphan",
              "Merge",
              "None"
            ],
            "description": "How the External Secrets Operator creates and owns the Secret.",
            "default": "Owner"
          },
          "deletionPolicy": {
            "type": [
              "null",
              "string"
            ],
            "enum": [
              null,
              "",
              "Delete",
              "Merge",
              "Retain"
            ],
            "description": "What happens to the Secret when the data is removed from the provider."
          },
          "immutable": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Create the Secret as immutable."
          },
          "template": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "Type of the created Secret."
              },
              "engineVersion": {
                "type": "string",
                "description": "Version of the template engine."
              },
              "mergePolicy": {
                "type": "string",
                "description": "How the template is merged with the fetched data."
              },
              "data": {
                "type": "object",
                "properties": {},
                "additionalProperties": {
                  "type": "string",
                  "description": "Template of the key"
                },
                "description": "Keys of the created Secret, rendered as templates."
              },
              "templateFrom": {
                "type": "array",
                "items": {
                  "description": "A template source, passed on as is."
                },
                "description": "Templates loaded from ConfigMaps or Secrets."
              },
              "metadata": {
                "type": "object",
                "properties": {
                  "annotations": {
                    "allOf": [
                      {
                        "$ref": "special/annotations.json"
                      }
                    ],
                    "description": "Annotations of the created Secret."
                  },
                  "labels": {
                    "allOf": [
                      {
                        "$ref": "special/labels.json"
                      }
                    ],
                    "description": "Labels of the created Secret."
                  }
                },
                "additionalProperties": false,
                "description": "Metadata of the created Secret."
              }
            },
            "description": "Template for the created Secret, passed as is. External Secrets Operator evaluates its own Go templates in here.",
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "description": "The Kubernetes Secret created by the External Secrets Operator."
      },
      "data": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "secretKey": {
              "type": "string",
              "description": "Key in the created Secret."
            },
            "remoteRef": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Key of the data in the provider."
                },
                "property": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Property of the provider data to use, when the data is a JSON or YAML document."
                },
                "version": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Version of the provider data to use."
                },
                "conversionStrategy": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "How the provider data is converted, for example `Default` or `Unicode`."
                },
                "decodingStrategy": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "How the provider data is decoded, for example `None`, `Base64`, `Base64URL` or `Auto`."
                },
                "metadataPolicy": {
                  "type": [
                    "null",
                    "string"
                  ],
                  "description": "Fetch the metadata of the provider data instead, for example `None` or `Fetch`."
                }
              },
              "additionalProperties": false,
              "description": "Reference to the data in the provider."
            },
            "sourceRef": {
              "type": "object",
              "properties": {},
              "description": "Override the store for this key, passed as is.",
              "additionalProperties": {
                "description": "A setting passed on as is."
              }
            }
          },
          "additionalProperties": false,
          "description": "Configuration for `externalSecret.main.data.$item`."
        },
        "description": "Individual keys to fetch from the provider, supports Helm `tpl`.",
        "default": []
      },
      "dataFrom": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "extract": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Key of the entry in the provider."
                },
                "property": {
                  "type": "string",
                  "description": "Property of the entry to extract."
                },
                "version": {
                  "type": "string",
                  "description": "Version of the entry."
                },
                "conversionStrategy": {
                  "type": "string",
                  "description": "How the value is converted or decoded, passed on as is."
                },
                "decodingStrategy": {
                  "type": "string",
                  "description": "How the value is converted or decoded, passed on as is."
                },
                "metadataPolicy": {
                  "type": "string",
                  "description": "Whether to fetch the metadata of the entry."
                }
              },
              "description": "Extract all keys from a single provider entry.",
              "additionalProperties": false
            },
            "find": {
              "type": "object",
              "properties": {},
              "description": "Find provider entries by name or tags.",
              "additionalProperties": {
                "description": "A setting passed on as is."
              }
            },
            "rewrite": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "regexp": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "description": "Regular expression to match the keys."
                      },
                      "target": {
                        "type": "string",
                        "description": "Replacement of the matched part."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Rewrite the keys with a regular expression."
                  },
                  "transform": {
                    "type": "object",
                    "properties": {
                      "template": {
                        "type": "string",
                        "description": "Go template that gets the key as `.value`."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Rewrite the keys with a template."
                  }
                },
                "description": "Configuration for `externalSecret.main.dataFrom.$item.rewrite.$item`.",
                "additionalProperties": false
              },
              "description": "Rewrite the keys of the fetched data."
            },
            "sourceRef": {
              "type": "object",
              "properties": {},
              "description": "Override the store for this entry, passed as is.",
              "additionalProperties": {
                "description": "A setting passed on as is."
              }
            }
          },
          "additionalProperties": false,
          "description": "Configuration for `externalSecret.main.dataFrom.$item`."
        },
        "description": "Fetch multiple keys from the provider at once, passed as is. External Secrets Operator evaluates its own Go templates in rewrite transforms.",
        "default": []
      }
    },
    "additionalProperties": false,
    "description": "Define ExternalSecret",
    "default": {}
  },
  "description": "Create ExternalSecret objects"
}
