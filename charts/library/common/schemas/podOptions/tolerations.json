{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "description": "See [Tolerations](/truecharts-common/workload#tolerations)",
  "items": {
    "type": "object",
    "properties": {
      "operator": {
        "type": "string",
        "description": "Operator: `Exists` or `Equal`."
      },
      "key": {
        "type": "string",
        "description": "Key of the taint."
      },
      "value": {
        "type": "string",
        "description": "Value of the taint, with `operator: Equal`."
      },
      "effect": {
        "type": "string",
        "description": "Effect of the taint: `NoSchedule`, `PreferNoSchedule` or `NoExecute`."
      },
      "tolerationSeconds": {
        "type": "integer",
        "description": "Seconds the pod stays bound to a node with a `NoExecute` taint, before it is evicted."
      }
    },
    "additionalProperties": false
  }
}
