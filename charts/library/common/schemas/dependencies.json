{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "valkey": {
      "allOf": [
        {
          "$ref": "../values.schema.source.json"
        },
        {
          "$ref": "#/additionalProperties/allOf/1"
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "$ref": "dependencies/valkey/operator/operator.json",
              "description": "Settings of the `ValkeyCluster` of the [valkey-operator](https://github.com/valkey-io/valkey-operator), used when `mode` is `operator`. The credentials stay in `depconfig`. Never merged into the chart values."
            }
          }
        }
      ],
      "description": "The valkey dependency. In `operator` mode a `ValkeyCluster` is spawned from `operator`."
    },
    "postgresql": {
      "allOf": [
        {
          "$ref": "../values.schema.source.json"
        },
        {
          "$ref": "#/additionalProperties/allOf/1"
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "standalone",
                "operator"
              ],
              "default": "operator",
              "description": "How postgresql is provided. Unlike the other dependencies it defaults to `operator`, so CloudNativePG runs it and the settings are under `operator`. `standalone` merges a plain PostgreSQL deployment into the chart. Both modes share `depconfig`, the connection details in `depconfig.creds` and the `postgresql-wait` init container."
            },
            "depconfig": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string",
                  "default": "PLACEHOLDERPASSWORD",
                  "description": "Password of the database user, for both modes."
                },
                "postgresqlUsername": {
                  "type": "string",
                  "minLength": 1,
                  "default": "app",
                  "description": "Name of the database user, for both modes."
                },
                "postgresqlDatabase": {
                  "type": "string",
                  "minLength": 1,
                  "default": "app",
                  "description": "Name of the database, for both modes."
                },
                "creds": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "default": {},
                  "description": "Connection details populated by the library, the same keys in both modes (eg `plainhost`, `plainporthost`, `complete`, `urlnossl`, `jdbc`). The read-only endpoint of the operator pooler (`operator.pooler.createRO`) adds the same keys suffixed with `RO` (eg `completeRO`). Read-only."
                }
              },
              "additionalProperties": false,
              "description": "Configuration of the dependency itself, for both modes. Never merged into the chart."
            },
            "operator": {
              "$ref": "dependencies/postgresql/operator/operator.json",
              "description": "Settings of the CloudNativePG `Cluster`, used when `mode` is `operator`. The credentials stay in `depconfig`. Never merged into the chart values."
            }
          }
        }
      ],
      "description": "The postgresql dependency. In `operator` mode (default) a CloudNativePG `Cluster` is spawned from `operator`."
    },
    "mariadb": {
      "allOf": [
        {
          "$ref": "../values.schema.source.json"
        },
        {
          "$ref": "#/additionalProperties/allOf/1"
        },
        {
          "type": "object",
          "properties": {
            "depconfig": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string",
                  "default": "PLACEHOLDERPASSWORD",
                  "description": "Password of the database user."
                },
                "rootPassword": {
                  "type": "string",
                  "minLength": 1,
                  "default": "PLACEHOLDERROOTPASSWORD",
                  "description": "Password of the `root` user."
                },
                "mariadbUsername": {
                  "type": "string",
                  "minLength": 1,
                  "default": "test",
                  "description": "Name of the database user."
                },
                "mariadbDatabase": {
                  "type": "string",
                  "minLength": 1,
                  "default": "test",
                  "description": "Name of the database."
                },
                "creds": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Connection details populated by the library (eg `plainhost`, `complete`). Read-only."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "mongodb": {
      "allOf": [
        {
          "$ref": "../values.schema.source.json"
        },
        {
          "$ref": "#/additionalProperties/allOf/1"
        },
        {
          "type": "object",
          "properties": {
            "depconfig": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string",
                  "default": "PLACEHOLDERPASSWORD",
                  "description": "Password of the database user."
                },
                "rootPassword": {
                  "type": "string",
                  "minLength": 1,
                  "default": "PLACEHOLDERROOTPASSWORD",
                  "description": "Password of the `root` user."
                },
                "mongodbUsername": {
                  "type": "string",
                  "minLength": 1,
                  "default": "test",
                  "description": "Name of the database user."
                },
                "mongodbDatabase": {
                  "type": "string",
                  "minLength": 1,
                  "default": "test",
                  "description": "Name of the database."
                },
                "creds": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Connection details populated by the library (eg `plainhost`, `complete`). Read-only."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "clickhouse": {
      "allOf": [
        {
          "$ref": "../values.schema.source.json"
        },
        {
          "$ref": "#/additionalProperties/allOf/1"
        },
        {
          "type": "object",
          "properties": {
            "depconfig": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string",
                  "default": "PLACEHOLDERPASSWORD",
                  "description": "Password of the database user."
                },
                "clickhouseUsername": {
                  "type": "string",
                  "minLength": 1,
                  "default": "test",
                  "description": "Name of the database user."
                },
                "clickhouseDatabase": {
                  "type": "string",
                  "minLength": 1,
                  "default": "test",
                  "description": "Name of the database."
                },
                "clickhouseDefaultAccessManagement": {
                  "type": "integer",
                  "default": 0,
                  "description": "Set to `1` to allow the user to manage users and grants with SQL."
                },
                "creds": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Connection details populated by the library (eg `plainhost`, `complete`). Read-only."
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    }
  },
  "additionalProperties": {
    "allOf": [
      {
        "$ref": "../values.schema.source.json"
      },
      {
        "type": "object",
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "string"
            ],
            "description": "Whether the dependency is enabled. Objects of disabled dependencies are not merged into the chart."
          },
          "mode": {
            "type": "string",
            "enum": [
              "standalone",
              "operator"
            ],
            "default": "standalone",
            "description": "How the dependency is provided. `standalone` merges and deploys it with the chart, `operator` leaves it to an operator, so its objects are not merged into the chart. The credentials, wait init container and notes still apply."
          },
          "depconfig": {
            "type": "object",
            "properties": {
              "password": {
                "type": "string",
                "description": "Password used by the dependency. Defaults to `PLACEHOLDERPASSWORD`."
              },
              "creds": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Connection details populated by the dependency (eg `plainhost`, `url`). Read-only."
              }
            },
            "description": "Configuration of the dependency itself. Never merged into the chart values."
          },
          "operator": {
            "type": "object",
            "description": "Settings specific to the operator providing the dependency (see `mode`). Never merged into the chart values."
          }
        }
      },
      {
        "required": [
          "enabled"
        ]
      },
      {
        "properties": {
          "depconfig": {
            "properties": {
              "password": {},
              "creds": {}
            },
            "additionalProperties": false
          },
          "operator": {
            "additionalProperties": {
              "description": "A setting for the operator. Never merged into the chart values."
            }
          }
        }
      }
    ]
  },
  "description": "Configuration for `dependencies`. Each dependency contains a complete chart values structure. Its objects are merged into the chart under the name `<dependency>-<object>`."
}
