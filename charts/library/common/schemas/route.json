{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Configuration for `route.main.enabled`.",
        "default": false
      },
      "kind": {
        "type": "string",
        "enum": [
          "GRPCRoute",
          "HTTPRoute",
          "TCPRoute",
          "TLSRoute",
          "UDPRoute"
        ],
        "description": "Configuration for `route.main.kind`.",
        "default": "HTTPRoute"
      },
      "annotations": {
        "type": "object",
        "properties": {},
        "additionalProperties": true,
        "description": "Configuration for `route.main.annotations`."
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Configuration for `route.main.labels`."
      },
      "targetSelector": {
        "type": [
          "null",
          "string"
        ],
        "description": "Configuration for `route.main.targetSelector`. Automatically links to a gateway defined in this chart."
      },
      "parentRefs": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "group": {
              "type": "string",
              "description": "Configuration for `route.main.parentRefs.$item.group`."
            },
            "kind": {
              "type": "string",
              "description": "Configuration for `route.main.parentRefs.$item.kind`."
            },
            "name": {
              "type": [
                "null",
                "string"
              ],
              "description": "Configuration for `route.main.parentRefs.$item.name`."
            },
            "namespace": {
              "type": [
                "null",
                "string"
              ],
              "description": "Namespace of the parent. Defaults to the namespace of the route."
            },
            "sectionName": {
              "type": [
                "null",
                "string"
              ],
              "description": "Attach to a single listener of the gateway. With `targetSelector` it must be a listener of that gateway."
            },
            "targetSelector": {
              "type": [
                "null",
                "string"
              ],
              "description": "Name of a gateway in this chart. Takes the place of `name` and `namespace`."
            },
            "port": {
              "type": [
                "null",
                "integer"
              ],
              "description": "Attach to the listeners of the gateway on this port."
            }
          },
          "additionalProperties": true,
          "description": "Configuration for `route.main.parentRefs.$item`."
        },
        "description": "Configuration for `route.main.parentRefs`."
      },
      "hostnames": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Host addresses, supports Helm `tpl`. Required for `TLSRoute`, not supported by `TCPRoute` and `UDPRoute`.",
        "default": []
      },
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "backendRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "group": {
                    "type": "string",
                    "description": "Configuration for `route.main.rules.$item.backendRefs.$item.group`."
                  },
                  "kind": {
                    "type": "string",
                    "description": "Configuration for `route.main.rules.$item.backendRefs.$item.kind`."
                  },
                  "name": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "description": "Name of the object, without any expanding. Cannot be used with `targetSelector`."
                  },
                  "namespace": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "description": "Namespace of the backend. Defaults to the namespace of the route."
                  },
                  "port": {
                    "type": [
                      "null",
                      "integer"
                    ],
                    "description": "Port of the backend. Defaults to the primary port of the selected service."
                  },
                  "weight": {
                    "type": "integer",
                    "description": "Share of the requests for this backend. Set to `0` to stop sending traffic to it. Defaults to `1`."
                  },
                  "targetSelector": {
                    "type": [
                      "null",
                      "string"
                    ],
                    "description": "Name of a service in this chart. Cannot be used with `name`."
                  },
                  "filters": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "description": "Filters applied only to this backend. Only for `HTTPRoute` and `GRPCRoute`."
                  }
                },
                "additionalProperties": true,
                "description": "Configuration for `route.main.rules.$item.backendRefs.$item`."
              },
              "description": "Where to send requests. Without this and without `filters`, the rule uses the primary service."
            },
            "matches": {
              "type": "array",
              "items": {
                "$ref": "route/match.json"
              },
              "description": "Conditions for matching requests. Only for `HTTPRoute` and `GRPCRoute`."
            },
            "name": {
              "type": "string",
              "description": "Name of the rule."
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              },
              "description": "Filters applied to requests matching this rule. Only for `HTTPRoute` and `GRPCRoute`. A rule with only filters needs no `backendRefs`, eg a redirect."
            },
            "timeouts": {
              "$ref": "route/timeouts.json",
              "description": "`request` and `backendRequest` timeouts. Only for `HTTPRoute`."
            },
            "retry": {
              "type": "object",
              "additionalProperties": true,
              "description": "Retry configuration. Only for `HTTPRoute`."
            },
            "sessionPersistence": {
              "type": "object",
              "additionalProperties": true,
              "description": "Session persistence, needs the experimental Gateway API channel. Only for `HTTPRoute` and `GRPCRoute`."
            }
          },
          "additionalProperties": true,
          "description": "Configuration for `route.main.rules.$item`."
        },
        "description": "Routing rules. Without rules everything goes to the primary service. Fields the route kind does not support fail rendering."
      }
    },
    "additionalProperties": true,
    "description": "Configuration for `route.main`.",
    "default": {}
  },
  "description": "Configuration for `route`."
}
