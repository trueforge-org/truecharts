{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Static provisioning settings for PVC/VCT in `nfs` mode.",
  "properties": {
    "server": {
      "type": "string",
      "minLength": 1,
      "default": ""
    },
    "share": {
      "type": "string",
      "minLength": 1,
      "default": ""
    }
  },
  "additionalProperties": true,
  "required": [
    "server",
    "share"
  ]
}
