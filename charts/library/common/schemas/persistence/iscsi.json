{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Configuration for `persistence` entries with `type: iscsi`.",
  "properties": {
    "iscsi": {
      "type": "object"
    },
    "targetPortal": {
      "type": "string",
      "minLength": 1
    },
    "iqn": {
      "type": "string",
      "minLength": 1
    },
    "lun": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true,
  "required": [
    "iqn",
    "iscsi",
    "lun",
    "targetPortal"
  ]
}
