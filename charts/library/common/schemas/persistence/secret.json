{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "../secret.json",
  "description": "Mirrors docs path persistence/secret.md and reuses shared schema secret.json.",
  "properties": {
    "objectName": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "key",
    "objectName",
    "path"
  ]
}
