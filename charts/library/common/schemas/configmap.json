{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "expandObjectName": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Prefix the name of the ConfigMap with the chart fullname.",
        "default": true,
        "x-helm-tpl": true
      },
      "data": {
        "type": "object",
        "properties": {},
        "additionalProperties": {
          "type": "string",
          "description": "Content of the entry."
        },
        "description": "Data entries of the ConfigMap, keyed by file or variable name. Values are Helm `tpl` strings.",
        "x-helm-tpl": "On value only",
        "x-docs-required": true
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Create this ConfigMap when true. Accepts a Helm `tpl` string that renders to `true` or `false`.",
        "default": false,
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Namespace to create this object in. Overrides the chart-wide `namespace` and `global.namespace`.",
        "default": "",
        "x-helm-tpl": true
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for configmap",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "special/annotations.json"
          }
        ],
        "description": "Additional annotations for configmap",
        "default": {},
        "x-helm-tpl": "On value only"
      }
    },
    "additionalProperties": false,
    "description": "A ConfigMap.",
    "default": {},
    "x-docs-required": true
  },
  "description": "ConfigMaps, keyed by name."
}
