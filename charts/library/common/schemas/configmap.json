{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "expandObjectName": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Prefix the object name with the chart fullname",
        "default": true
      },
      "data": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": {
          "type": "string",
          "description": "Content of the ConfigMap entry"
        },
        "description": "Data entries of the ConfigMap, keyed by file or variable name"
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enables or Disables the Configmap",
        "default": false
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": ""
      },
      "labels": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": {
          "type": "string",
          "description": "Value of the label"
        },
        "description": "Additional labels for configmap",
        "default": {}
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": {
          "type": "string",
          "description": "Value of the annotation"
        },
        "description": "Additional annotations for configmap",
        "default": {}
      }
    },
    "additionalProperties": false,
    "description": "Define Configmap",
    "default": {}
  },
  "description": "Create Configmap objects"
}
