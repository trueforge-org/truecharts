{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "expandObjectName": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Prefix the object name with the chart fullname",
        "default": true
      },
      "data": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Create Configmap objects"
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enables or Disables the Configmap",
        "default": false
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": ""
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for configmap",
        "type": [
          "object",
          "string"
        ],
        "default": {}
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Additional annotations for configmap",
        "default": {}
      }
    },
    "additionalProperties": false,
    "description": "Define Configmap",
    "default": {}
  },
  "description": "Create Configmap objects"
}
