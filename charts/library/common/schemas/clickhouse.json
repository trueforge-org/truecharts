{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Enables the ClickHouse dependency. Supports Helm `tpl`.",
      "default": false,
      "x-helm-tpl": true
    },
    "includeCommon": {
      "type": "boolean",
      "description": "Marker for charts that the dependency uses common. Not read by common.",
      "default": false
    },
    "password": {
      "type": "string",
      "description": "Password of the database user.",
      "minLength": 1,
      "default": "PLACEHOLDERPASSWORD"
    },
    "clickhouseUsername": {
      "type": "string",
      "description": "Name of the database user, used in the connection URLs."
    },
    "clickhouseDatabase": {
      "type": "string",
      "description": "Name of the database, used in the connection URLs."
    },
    "creds": {
      "type": "object",
      "properties": {
        "clickhousePassword": {
          "type": "string",
          "description": "Password."
        },
        "plain": {
          "type": "string",
          "description": "Hostname."
        },
        "plainhost": {
          "type": "string",
          "description": "Hostname."
        },
        "plainport": {
          "type": "string",
          "description": "Hostname and port."
        },
        "plainporthost": {
          "type": "string",
          "description": "Hostname and port."
        },
        "ping": {
          "type": "string",
          "description": "URL of the ping endpoint, used by the wait container."
        },
        "complete": {
          "type": "string",
          "description": "Connection URL."
        },
        "jdbc": {
          "type": "string",
          "description": "JDBC URL."
        }
      },
      "additionalProperties": false,
      "description": "Connection details written by common, so apps using the dependency can use them. Read only.",
      "default": {}
    }
  },
  "additionalProperties": false,
  "description": "ClickHouse dependency configuration."
}
