{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "provisioner": {
        "type": "string",
        "description": "Provisioner name for the priority class. Set in the common-test priorityclass fixture; the priority class templates ignore it."
      },
      "preemptionPolicy": {
        "type": "string",
        "description": "Define priority classes",
        "enum": [
          "PreemptLowerPriority",
          "Never"
        ],
        "default": "Immediate"
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Enables or Disables the priority class",
        "default": false,
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": "",
        "x-helm-tpl": "On value only"
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for priority class",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "special/annotations.json"
          }
        ],
        "description": "Additional annotations for priority class",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "value": {
        "type": "integer",
        "description": "Define the value for this priority class",
        "default": 1000000
      },
      "globalDefault": {
        "type": "boolean",
        "description": "Define if this priority class is the global default",
        "default": false
      },
      "description": {
        "type": "string",
        "description": "Define the description for this priority class",
        "default": "No description given"
      }
    },
    "additionalProperties": false,
    "description": "Define priority class",
    "default": {},
    "x-docs-required": true
  },
  "description": "Define priority classes"
}
