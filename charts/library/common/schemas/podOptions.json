    "defaultSpread": {
      "type": "boolean"
    },
    "defaultAffinity": {
      "type": "boolean"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "tolerations": {
      "type": "array"
    },
    "schedulerName": {
      "type": "string"
    },
    "priorityClassName": {
      "type": "string"
    },
    "runtimeClassName": {
      "type": "string"
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer"
    }
