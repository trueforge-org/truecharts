{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "description": "Value of the parameter"
        },
        "description": "Parameters passed to the CSI driver. Supports Helm `tpl` on keys and values.",
        "default": {},
        "x-helm-tpl": "On keys and values"
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Labels of the VolumeSnapshotClass.",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "special/annotations.json"
          }
        ],
        "description": "Annotations of the VolumeSnapshotClass.",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Create this volume snapshot class when true. Accepts a Helm `tpl` string that renders to `true` or `false`.",
        "default": false,
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "isDefault": {
        "type": "boolean",
        "description": "Make this the default VolumeSnapshotClass. Sets the annotation `snapshot.storage.kubernetes.io/is-default-class` to `\"true\"` or `\"false\"`.",
        "default": false
      },
      "driver": {
        "type": "string",
        "description": "CSI driver that takes the snapshots.",
        "minLength": 1,
        "x-helm-tpl": true,
        "x-docs-required": true,
        "examples": [
          "driver.longhorn.io"
        ]
      },
      "deletionPolicy": {
        "type": "string",
        "enum": [
          "Retain",
          "Delete"
        ],
        "description": "What happens to the snapshot content when a VolumeSnapshot is deleted.",
        "default": "Retain"
      }
    },
    "additionalProperties": false,
    "description": "A VolumeSnapshotClass.",
    "default": {}
  },
  "description": "VolumeSnapshotClasses, keyed by name."
}
