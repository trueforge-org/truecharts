{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "../probes.json",
  "description": "Mirrors docs path container/probes.md and reuses shared schema probes.json.",
  "properties": {
    "probes": {
      "type": "object"
    },
    "liveness": {
      "type": "object"
    },
    "readiness": {
      "type": "object"
    }
  },
  "required": [
    "liveness",
    "probes",
    "readiness"
  ]
}
