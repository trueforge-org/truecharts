{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "unhealthyPodEvictionPolicy": {
        "type": "string",
        "description": "Create Pod Disruption Budget objects",
        "oneOf": [
          {
            "enum": [
              "IfHealthyBudget",
              "AlwaysAllow"
            ]
          },
          {
            "type": "string",
            "pattern": "^\\{\\{.*\\}\\}$"
          }
        ],
        "default": ""
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Create Pod Disruption Budget objects",
        "default": false
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": ""
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for Pod Disruption Budget",
        "type": [
          "object",
          "string"
        ],
        "default": {}
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Additional annotations for Pod Disruption Budget",
        "default": {}
      },
      "minAvailable": {
        "type": [
          "integer",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Define the minAvailable.",
        "default": ""
      },
      "maxUnavailable": {
        "type": [
          "integer",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Define the maxUnavailable.",
        "default": ""
      },
      "targetSelector": {
        "type": "string",
        "description": "Configuration for `podDisruptionBudget.main.targetSelector`."
      },
      "customLabels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Custom labels used to select the pods covered by this Pod Disruption Budget, replacing the automatically selected pod labels"
      }
    },
    "additionalProperties": false,
    "description": "Create Pod Disruption Budget objects",
    "default": {}
  },
  "description": "Create Pod Disruption Budget objects"
}
