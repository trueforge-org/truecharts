{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "mountOptions": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "A mount option."
        },
        "description": "Mount options of volumes of this class. Supports Helm `tpl` on each entry.",
        "default": [],
        "x-helm-tpl": "On entries only",
        "examples": [
          [
            "nfsvers=4.1"
          ]
        ]
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Create this storage class when true. Accepts a Helm `tpl` string that renders to `true` or `false`.",
        "default": false,
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for storage class",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "special/annotations.json"
          }
        ],
        "description": "Additional annotations for storage class",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "provisioner": {
        "type": "string",
        "description": "Provisioner (CSI driver) that provisions volumes of this class.",
        "x-docs-required": true,
        "examples": [
          "nfs.csi.k8s.io"
        ]
      },
      "isDefault": {
        "type": "boolean",
        "description": "Make this the default StorageClass of the cluster."
      },
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": {
          "type": "string",
          "description": "Value of the parameter."
        },
        "description": "Parameters passed to the provisioner. Supports Helm `tpl` on values.",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "reclaimPolicy": {
        "type": "string",
        "enum": [
          "Delete",
          "Retain"
        ],
        "description": "What happens to a volume when its claim is deleted.",
        "default": "Retain"
      },
      "allowVolumeExpansion": {
        "type": "boolean",
        "description": "Allow claims of this class to be resized.",
        "default": false
      },
      "volumeBindingMode": {
        "type": "string",
        "enum": [
          "Immediate",
          "WaitForFirstConsumer"
        ],
        "description": "When volumes are bound and provisioned. `WaitForFirstConsumer` waits until a pod uses the claim.",
        "default": "Immediate"
      }
    },
    "additionalProperties": false,
    "description": "A StorageClass.",
    "default": {},
    "x-docs-required": true
  },
  "description": "StorageClasses, keyed by name."
}
