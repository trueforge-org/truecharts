{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "matchLabels": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "type": "string",
        "description": "Value of the label"
      },
      "description": "Match by labels."
    },
    "matchExpressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Label key the selector applies to."
          },
          "operator": {
            "type": "string",
            "description": "Relationship of the key to the values, e.g. `In`, `NotIn`, `Exists` or `DoesNotExist`."
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Values of the label. Empty for `Exists` and `DoesNotExist`."
          }
        },
        "additionalProperties": false
      },
      "description": "Match by label expressions."
    }
  },
  "additionalProperties": false,
  "description": "A label selector, matches by labels and label expressions."
}
