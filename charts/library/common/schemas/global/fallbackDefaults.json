{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "storageClass": {
      "type": [
        "string",
        "null"
      ],
      "description": "Storage class of a pvc that sets none. `-` leaves it unset.",
      "default": null
    },
    "probeType": {
      "type": "string",
      "description": "Type of a probe that sets none.",
      "default": "http",
      "minLength": 1,
      "x-docs-required": true
    },
    "serviceProtocol": {
      "type": "string",
      "description": "Protocol of a service port that sets none.",
      "default": "tcp",
      "minLength": 1,
      "x-docs-required": true
    },
    "serviceType": {
      "type": "string",
      "description": "Type of a service that sets none.",
      "default": "ClusterIP",
      "minLength": 1,
      "x-docs-required": true
    },
    "persistenceType": {
      "type": "string",
      "description": "Type of a persistence entry that sets none.",
      "default": "pvc",
      "minLength": 1,
      "x-docs-required": true
    },
    "pvcRetain": {
      "type": "boolean",
      "description": "Keep the pvcs when the release is deleted, for persistence that sets no `retain`.",
      "default": false,
      "x-docs-required": true
    },
    "pvcSize": {
      "type": "string",
      "description": "Size of a pvc that sets none.",
      "default": "100Gi",
      "minLength": 1,
      "x-docs-required": true
    },
    "vctSize": {
      "type": "string",
      "description": "Size of a volume claim template that sets none.",
      "default": "100Gi",
      "minLength": 1,
      "x-docs-required": true
    },
    "accessModes": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Configuration for `global.fallbackDefaults.accessModes.$item`."
      },
      "description": "Access modes of a pvc that sets none.",
      "default": [
        "ReadWriteOnce"
      ],
      "x-docs-required": true
    },
    "vctAccessModes": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Configuration for `global.fallbackDefaults.vctAccessModes.$item`."
      },
      "description": "Access modes of a volume claim template that sets none.",
      "default": [
        "ReadWriteOnce"
      ]
    },
    "probeTimeouts": {
      "type": "object",
      "properties": {
        "liveness": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "description": "Seconds before the first probe.",
              "default": 12,
              "minimum": 1,
              "x-docs-required": true
            },
            "periodSeconds": {
              "type": "integer",
              "description": "Seconds between probes.",
              "default": 15,
              "minimum": 1,
              "x-docs-required": true
            },
            "timeoutSeconds": {
              "type": "integer",
              "description": "Seconds before a probe times out.",
              "default": 5,
              "minimum": 1,
              "x-docs-required": true
            },
            "failureThreshold": {
              "type": "integer",
              "description": "Failed probes in a row before the probe fails.",
              "default": 5,
              "minimum": 1,
              "x-docs-required": true
            },
            "successThreshold": {
              "type": "integer",
              "description": "Successful probes in a row before the probe succeeds.",
              "default": 1,
              "minimum": 1,
              "x-docs-required": true
            }
          },
          "additionalProperties": false,
          "description": "Timings of liveness probes.",
          "default": {
            "initialDelaySeconds": 12,
            "periodSeconds": 15,
            "timeoutSeconds": 5,
            "failureThreshold": 5,
            "successThreshold": 1
          },
          "x-docs-required": true
        },
        "readiness": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "description": "Seconds before the first probe.",
              "default": 10,
              "minimum": 1,
              "x-docs-required": true
            },
            "periodSeconds": {
              "type": "integer",
              "description": "Seconds between probes.",
              "default": 12,
              "minimum": 1,
              "x-docs-required": true
            },
            "timeoutSeconds": {
              "type": "integer",
              "description": "Seconds before a probe times out.",
              "default": 5,
              "minimum": 1,
              "x-docs-required": true
            },
            "failureThreshold": {
              "type": "integer",
              "description": "Failed probes in a row before the probe fails.",
              "default": 4,
              "minimum": 1,
              "x-docs-required": true
            },
            "successThreshold": {
              "type": "integer",
              "description": "Successful probes in a row before the probe succeeds.",
              "default": 2,
              "minimum": 1,
              "x-docs-required": true
            }
          },
          "additionalProperties": false,
          "description": "Timings of readiness probes.",
          "default": {
            "initialDelaySeconds": 10,
            "periodSeconds": 12,
            "timeoutSeconds": 5,
            "failureThreshold": 4,
            "successThreshold": 2
          },
          "x-docs-required": true
        },
        "startup": {
          "type": "object",
          "properties": {
            "initialDelaySeconds": {
              "type": "integer",
              "description": "Seconds before the first probe.",
              "default": 10,
              "minimum": 1,
              "x-docs-required": true
            },
            "periodSeconds": {
              "type": "integer",
              "description": "Seconds between probes.",
              "default": 5,
              "minimum": 1,
              "x-docs-required": true
            },
            "timeoutSeconds": {
              "type": "integer",
              "description": "Seconds before a probe times out.",
              "default": 3,
              "minimum": 1,
              "x-docs-required": true
            },
            "failureThreshold": {
              "type": "integer",
              "description": "Failed probes in a row before the probe fails.",
              "default": 60,
              "minimum": 1,
              "x-docs-required": true
            },
            "successThreshold": {
              "type": "integer",
              "description": "Successful probes in a row before the probe succeeds.",
              "default": 1,
              "minimum": 1,
              "x-docs-required": true
            }
          },
          "additionalProperties": false,
          "description": "Timings of startup probes.",
          "default": {
            "initialDelaySeconds": 10,
            "periodSeconds": 5,
            "timeoutSeconds": 3,
            "failureThreshold": 60,
            "successThreshold": 1
          },
          "x-docs-required": true
        }
      },
      "additionalProperties": false,
      "description": "Timings of the probes that set none.",
      "default": {
        "liveness": {
          "initialDelaySeconds": 10,
          "periodSeconds": 10,
          "timeoutSeconds": 5,
          "failureThreshold": 5,
          "successThreshold": 1
        },
        "readiness": {
          "initialDelaySeconds": 10,
          "periodSeconds": 10,
          "timeoutSeconds": 5,
          "failureThreshold": 5,
          "successThreshold": 2
        },
        "startup": {
          "initialDelaySeconds": 10,
          "periodSeconds": 5,
          "timeoutSeconds": 2,
          "failureThreshold": 60,
          "successThreshold": 1
        }
      },
      "x-docs-required": true
    },
    "topologyKey": {
      "type": "string",
      "description": "Topology key of the default topology spread constraints.",
      "default": "kubernetes.io/hostname"
    },
    "allowRollingUpdateWithRWO": {
      "type": "boolean",
      "description": "Keep `strategy: RollingUpdate` on a single replica Deployment with `ReadWriteOnce` volumes, instead of changing it to `Recreate`. Can be overruled with `workload.$name.allowRollingUpdateWithRWO`. Updates can get stuck if the storage stays locked to the old pod, which can happen on the same node with storage like iSCSI, and two pods use the same data during an update.\n\n:::caution\n\nEnabling this applies to all workloads of the chart that set `strategy: RollingUpdate`. Common shows a warning in the notes for each of them.\n\n:::",
      "default": false
    },
    "routeListenerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Port of the listeners created for route TLS. Can be overruled per route with `route.$name.listenerPort`. Traefik needs the port of its entrypoint here, which is not always the port it is exposed on.",
      "default": 443
    },
    "cnpg": {
      "type": "object",
      "properties": {
        "pgVersion": {
          "type": "integer",
          "description": "Major PostgreSQL version of a cluster that sets no `pgVersion`.",
          "default": 18
        },
        "skipEmptyWalArchiveCheck": {
          "type": "boolean",
          "description": "Skip the check that the WAL archive of a new cluster is empty.",
          "default": true
        }
      },
      "additionalProperties": false,
      "description": "Defaults of the postgresql dependency in `operator` mode."
    }
  },
  "additionalProperties": false,
  "description": "Configuration for `global.fallbackDefaults`."
}
