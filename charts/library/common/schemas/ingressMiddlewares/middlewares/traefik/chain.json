{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Configuration for the Traefik chain middleware.",
  "properties": {
    "middlewares": {
      "type": "object"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "expandObjectName": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "expandObjectName",
    "middlewares",
    "name"
  ]
}
