{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Configuration for the Traefik replace-path-regex middleware.",
  "properties": {
    "regex": {
      "type": "string",
      "minLength": 1
    },
    "replacement": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "required": [
    "regex",
    "replacement"
  ]
}
