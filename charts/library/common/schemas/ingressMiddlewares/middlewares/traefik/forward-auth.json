{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Configuration for the Traefik forward-auth middleware.",
  "properties": {
    "address": {
      "type": "string",
      "minLength": 1
    },
    "authResponseHeadersRegex": {
      "type": "string",
      "minLength": 1
    },
    "trustForwardHeader": {
      "type": "boolean",
      "default": false
    },
    "authResponseHeaders": {
      "type": "array",
      "minLength": 1,
      "default": []
    },
    "authRequestHeaders": {
      "type": "array",
      "minLength": 1,
      "default": []
    },
    "tls": {
      "type": "object",
      "default": {}
    },
    "insecureSkipVerify": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "required": [
    "address",
    "authRequestHeaders",
    "authResponseHeaders",
    "authResponseHeadersRegex",
    "insecureSkipVerify",
    "tls",
    "trustForwardHeader"
  ]
}
