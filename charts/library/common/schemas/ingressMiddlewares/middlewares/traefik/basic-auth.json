{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Mirrors docs path middlewares/traefik/basic-auth.md.",
  "properties": {
    "users": {
      "type": "object"
    },
    "username": {
      "type": "string",
      "minLength": 1
    },
    "password": {
      "type": "string",
      "minLength": 1
    },
    "secret": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "required": [
    "password",
    "secret",
    "username",
    "users"
  ]
}
