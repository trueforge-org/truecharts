{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "path": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Exact",
            "PathPrefix",
            "RegularExpression"
          ],
          "description": "How the path is matched: `PathPrefix`, `Exact` or `RegularExpression`."
        },
        "value": {
          "type": "string",
          "description": "Path that is matched. Supports Helm `tpl`."
        }
      },
      "additionalProperties": false,
      "description": "Path condition for the match."
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A header the request has to match.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the header."
          },
          "value": {
            "type": "string",
            "description": "Value that is matched."
          },
          "type": {
            "type": "string",
            "enum": [
              "Exact",
              "RegularExpression"
            ],
            "description": "How the value is matched: `Exact` or `RegularExpression`."
          }
        },
        "additionalProperties": false
      },
      "description": "Headers the request has to match."
    },
    "queryParams": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "A query parameter the request has to match.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the query parameter."
          },
          "value": {
            "type": "string",
            "description": "Value that is matched."
          },
          "type": {
            "type": "string",
            "enum": [
              "Exact",
              "RegularExpression"
            ],
            "description": "How the value is matched: `Exact` or `RegularExpression`."
          }
        },
        "additionalProperties": false
      },
      "description": "Query parameters the request has to match."
    },
    "method": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "DELETE",
            "CONNECT",
            "OPTIONS",
            "TRACE",
            "PATCH"
          ],
          "description": "HTTP method of the request. For `HTTPRoute`."
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Exact",
                "RegularExpression"
              ],
              "description": "How the service and method are matched: `Exact` or `RegularExpression`."
            },
            "service": {
              "type": "string",
              "description": "Name of the gRPC service."
            },
            "method": {
              "type": "string",
              "description": "Name of the gRPC method."
            }
          },
          "additionalProperties": false,
          "description": "The gRPC service and method of the request. For `GRPCRoute`."
        }
      ],
      "description": "HTTP method of the request for an `HTTPRoute`, or the gRPC service and method for a `GRPCRoute`."
    }
  },
  "additionalProperties": false,
  "description": "A match condition for an HTTP or gRPC route."
}
