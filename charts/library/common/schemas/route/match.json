{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "path": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Exact",
            "PathPrefix",
            "RegularExpression"
          ],
          "description": "How the path is matched: `PathPrefix`, `Exact` or `RegularExpression`."
        },
        "value": {
          "type": "string",
          "description": "Path that is matched. Supports Helm `tpl`."
        }
      },
      "additionalProperties": false,
      "description": "Path condition for the match."
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the header or query parameter."
          },
          "value": {
            "type": "string",
            "description": "Value that is matched."
          },
          "type": {
            "type": "string",
            "enum": [
              "Exact",
              "RegularExpression"
            ],
            "description": "How the value is matched: `Exact` or `RegularExpression`."
          }
        },
        "additionalProperties": false
      },
      "description": "Headers the request has to match."
    },
    "queryParams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the header or query parameter."
          },
          "value": {
            "type": "string",
            "description": "Value that is matched."
          },
          "type": {
            "type": "string",
            "enum": [
              "Exact",
              "RegularExpression"
            ],
            "description": "How the value is matched: `Exact` or `RegularExpression`."
          }
        },
        "additionalProperties": false
      },
      "description": "Query parameters the request has to match."
    },
    "method": {
      "type": [
        "object",
        "string"
      ],
      "description": "HTTP method of the request, or the gRPC service and method."
    }
  },
  "additionalProperties": false,
  "description": "A match condition for an HTTP or gRPC route."
}
