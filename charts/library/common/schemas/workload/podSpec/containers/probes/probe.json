{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Enable or disable the probe.",
      "x-docs-required": true
    },
    "type": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "exec",
            "http",
            "https",
            "tcp",
            "grpc"
          ]
        },
        {
          "type": "string",
          "pattern": "^\\{\\{.*\\}\\}$"
        }
      ],
      "description": "Probe handler type.",
      "x-helm-tpl": true
    },
    "port": {
      "type": [
        "integer",
        "string"
      ],
      "description": "Probe port. Used by HTTP, HTTPS, TCP, and gRPC probes.",
      "x-helm-tpl": true,
      "x-docs-required": true
    },
    "path": {
      "type": "string",
      "description": "Request path used by HTTP and HTTPS probes.",
      "x-helm-tpl": true
    },
    "httpHeaders": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "HTTP headers sent with HTTP and HTTPS probes.",
      "default": {},
      "x-helm-tpl": "On value only"
    },
    "spec": {
      "type": "object",
      "properties": {
        "successThreshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Successful probes in a row before the probe succeeds."
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "Seconds before the first probe."
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds between probes."
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Seconds before a probe times out."
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "description": "Failed probes in a row before the probe fails."
        }
      },
      "additionalProperties": false,
      "description": "Probe timing and threshold settings."
    },
    "command": {
      "type": [
        "array",
        "string"
      ],
      "description": "Define the command to run. Only applies when `type: exec`",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "description": "Configuration for a workload probe."
}
