{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": [
    "object",
    "null"
  ],
  "description": "Shared schema for environment variable maps used across common templates.",
  "properties": {},
  "additionalProperties": {
    "type": [
      "string",
      "number",
      "integer",
      "boolean",
      "object",
      "null"
    ],
    "description": "Environment variable entry by key. A scalar or null is the value, a map holds exactly one of `configMapKeyRef`, `secretKeyRef` or `fieldRef`.",
    "properties": {
      "configMapKeyRef": {
        "type": "object",
        "description": "Reference an entry from a ConfigMap.",
        "properties": {
          "name": {
            "type": "string",
            "description": "ConfigMap name.",
            "x-helm-tpl": true,
            "x-docs-required": true
          },
          "key": {
            "type": "string",
            "description": "ConfigMap key.",
            "x-docs-required": true
          },
          "expandObjectName": {
            "type": [
              "boolean",
              "string"
            ],
            "description": "Expand object names using chart naming."
          }
        },
        "additionalProperties": false
      },
      "secretKeyRef": {
        "type": "object",
        "description": "Reference an entry from a Secret.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Secret name.",
            "x-helm-tpl": true,
            "x-docs-required": true
          },
          "key": {
            "type": "string",
            "description": "Secret key.",
            "x-docs-required": true
          },
          "expandObjectName": {
            "type": [
              "boolean",
              "string"
            ],
            "description": "Expand object names using chart naming."
          }
        },
        "additionalProperties": false
      },
      "fieldRef": {
        "type": "object",
        "description": "Reference a field from the Pod metadata/spec.",
        "properties": {
          "fieldPath": {
            "type": "string",
            "description": "Field path.",
            "x-docs-required": true
          },
          "apiVersion": {
            "type": "string",
            "description": "API version for the field path."
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false,
    "x-helm-tpl": "Only on value, when it's a string",
    "x-docs-required": true
  },
  "x-docs-required": false,
  "x-docs-helmTpl": false
}
