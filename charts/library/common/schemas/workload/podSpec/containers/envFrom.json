{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "configMapRef": {
        "type": "object",
        "properties": {
          "expandObjectName": {
            "type": "boolean",
            "description": "Define envFrom for the container"
          },
          "name": {
            "type": "string",
            "description": "Define the configmap name This will be automatically expanded to `fullname-configmap-name`."
          }
        },
        "additionalProperties": true,
        "description": "Define the configMapRef"
      },
      "secretRef": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Define the secret name This will be automatically expanded to `fullname-secret-name`."
          },
          "expandObjectName": {
            "type": "boolean",
            "description": "Whether to expand (adding the fullname as prefix) the secret name"
          }
        },
        "additionalProperties": true,
        "description": "Define the secretRef"
      }
    },
    "additionalProperties": true
  },
  "description": "Define envFrom for the container"
}
