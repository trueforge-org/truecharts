{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "subjects": {
        "type": "array",
        "properties": {},
        "additionalProperties": {
          "type": "object",
          "properties": {
            "apiGroup": {
              "type": "string",
              "description": "API group of the subject, eg `rbac.authorization.k8s.io`."
            },
            "kind": {
              "type": "string",
              "description": "Define the `kind` of `subjects` entry"
            },
            "name": {
              "type": "string",
              "description": "Define the `name` of `subjects` entry"
            }
          },
          "additionalProperties": false,
          "description": "Configuration for `$name.subjects.$name`."
        },
        "description": "Define `subjects` for (Cluster)RoleBinding",
        "default": []
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enables or Disables the rbac",
        "default": false,
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "primary": {
        "type": "boolean",
        "description": "Sets the rbac as primary",
        "default": false
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object (Only when clusterWide is false)",
        "default": "",
        "x-helm-tpl": true
      },
      "clusterWide": {
        "type": "boolean",
        "description": "Sets the rbac as cluster wide (ClusterRole, ClusterRoleBinding)",
        "default": false
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for rbac",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "special/annotations.json"
          }
        ],
        "description": "Additional annotations for rbac",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "allServiceAccounts": {
        "type": "boolean",
        "description": "Whether to assign all service accounts or not to the (Cluster)RoleBinding"
      },
      "serviceAccounts": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "description": "A setting passed on as is."
            }
          }
        ],
        "description": "Define the service account(s) to assign the (Cluster)RoleBinding",
        "type": "array",
        "default": []
      },
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "apiGroups": {
              "type": "array",
              "description": "Define the `apiGroups` list for the `rules` for the (Cluster)Role",
              "x-helm-tpl": "On entries only",
              "x-docs-required": true
            },
            "resources": {
              "type": "array",
              "description": "Define the `resources` list for the `rules` for the (Cluster)Role",
              "x-helm-tpl": "On entries only",
              "x-docs-required": true
            },
            "resourceNames": {
              "type": "array",
              "description": "Define the `resourceNames` list for the `rules` for the (Cluster)Role",
              "x-helm-tpl": "On entries only"
            },
            "verbs": {
              "type": "array",
              "description": "Define the `verbs` list for the `rules` for the (Cluster)Role",
              "x-helm-tpl": "On entries only",
              "x-docs-required": true
            },
            "nonResourceURLs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Define the `nonResourceURLs` list for the `rules` for the (Cluster)Role"
            }
          },
          "additionalProperties": false
        },
        "description": "Define the `rules` for the (Cluster)Role",
        "default": [],
        "x-docs-required": true
      }
    },
    "additionalProperties": false,
    "description": "Define rbac",
    "default": {},
    "x-docs-required": true
  },
  "description": "Create rbac objects"
}
