{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Configuration for `gateway.main.enabled`.",
        "default": false
      },
      "primary": {
        "type": "boolean",
        "description": "Configuration for `gateway.main.primary`."
      },
      "namespace": {
        "type": "string",
        "description": "Configuration for `gateway.main.namespace`."
      },
      "nameOverride": {
        "type": "string",
        "description": "Configuration for `gateway.main.nameOverride`."
      },
      "annotations": {
        "type": "object",
        "properties": {},
        "additionalProperties": true,
        "description": "Configuration for `gateway.main.annotations`."
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Configuration for `gateway.main.labels`."
      },
      "gatewayClassName": {
        "type": "string",
        "description": "The name of the GatewayClass resource that this Gateway references.",
        "examples": [
          "traefik"
        ]
      },
      "targetSelector": {
        "type": "string",
        "description": "Name-based selector for automatic GatewayClass linking. When set, automatically references the specified `gatewayClass.$name`.",
        "examples": [
          "main"
        ]
      },
      "addresses": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Type of the address, like `IPAddress` or `Hostname`. Defaults to `IPAddress` in Gateway API."
            },
            "value": {
              "type": "string",
              "description": "The address value, like an IP address or a hostname."
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false,
          "description": "A requested address for the gateway."
        },
        "description": "Requested addresses for the gateway. Passed as is."
      },
      "infrastructure": {
        "type": "object",
        "additionalProperties": true,
        "description": "Infrastructure settings of the gateway. Passed as is."
      },
      "allowedListeners": {
        "type": "object",
        "properties": {
          "namespaces": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "enum": [
                  "All",
                  "Selector",
                  "Same",
                  "None"
                ],
                "description": "Namespaces from which ListenerSets may attach. Valid options are All, Selector, Same, and None.",
                "default": "None"
              },
              "selector": {
                "type": "object",
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true,
                    "description": "Match namespaces by labels."
                  },
                  "matchExpressions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true
                    },
                    "description": "Match namespaces by label expressions."
                  }
                },
                "additionalProperties": false,
                "description": "Namespace selector used when `from` is `Selector`."
              }
            },
            "additionalProperties": false,
            "description": "Namespaces from which ListenerSets may attach."
          }
        },
        "additionalProperties": false,
        "description": "Configure `namespaces.from` as `Same`, `All`, `Selector`, or `None` to control which ListenerSets may attach. Set `namespaces.selector` when `from` is `Selector`."
      },
      "tls": {
        "type": "object",
        "additionalProperties": true,
        "description": "Gateway wide TLS settings. Passed as is."
      },
      "listeners": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Configuration for `gateway.main.listeners.$item.name`.",
              "minLength": 1
            },
            "hostname": {
              "type": [
                "null",
                "string"
              ],
              "description": "Hostname of the listener, supports Helm `tpl`."
            },
            "port": {
              "type": "integer",
              "description": "Configuration for `gateway.main.listeners.$item.port`.",
              "minimum": 1
            },
            "protocol": {
              "type": "string",
              "enum": [
                "HTTP",
                "HTTPS",
                "TCP",
                "TLS",
                "UDP"
              ],
              "description": "Configuration for `gateway.main.listeners.$item.protocol`."
            },
            "tls": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "Terminate",
                    "Passthrough"
                  ],
                  "description": "Configuration for `gateway.main.listeners.$item.tls.mode`."
                },
                "certificateRefs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string",
                        "description": "Configuration for `gateway.main.listeners.$item.tls.certificateRefs.$item.group`."
                      },
                      "kind": {
                        "type": "string",
                        "description": "Configuration for `gateway.main.listeners.$item.tls.certificateRefs.$item.kind`."
                      },
                      "name": {
                        "type": "string",
                        "description": "Configuration for `gateway.main.listeners.$item.tls.certificateRefs.$item.name`.",
                        "minLength": 1
                      },
                      "namespace": {
                        "type": [
                          "null",
                          "string"
                        ],
                        "description": "Configuration for `gateway.main.listeners.$item.tls.certificateRefs.$item.namespace`."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Configuration for `gateway.main.listeners.$item.tls.certificateRefs.$item`."
                  },
                  "description": "Configuration for `gateway.main.listeners.$item.tls.certificateRefs`."
                },
                "options": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Implementation specific TLS options. Passed as is."
                }
              },
              "additionalProperties": false,
              "description": "Configuration for `gateway.main.listeners.$item.tls`."
            },
            "allowedRoutes": {
              "type": "object",
              "properties": {
                "namespaces": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "enum": [
                        "All",
                        "Same",
                        "Selector"
                      ],
                      "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes.namespaces.from`.",
                      "default": "Same"
                    },
                    "selector": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true,
                      "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes.namespaces.selector`."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes.namespaces`."
                },
                "kinds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string",
                        "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes.kinds.$item.group`."
                      },
                      "kind": {
                        "type": "string",
                        "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes.kinds.$item.kind`.",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false,
                    "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes.kinds.$item`."
                  },
                  "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes.kinds`."
                }
              },
              "additionalProperties": false,
              "description": "Configuration for `gateway.main.listeners.$item.allowedRoutes`."
            }
          },
          "additionalProperties": false,
          "description": "Configuration for `gateway.main.listeners.$item`."
        },
        "description": "Array of listener definitions that define the network ports and protocols the Gateway listens on.\n\nEach listener must specify:\n- `name`: Unique name for the listener\n- `port`: Network port to listen on\n- `protocol`: Protocol (HTTP, HTTPS, TCP, TLS, UDP)\n- `hostname`: Optional hostname filter\n- `tls`: Optional TLS configuration\n- `allowedRoutes`: Optional configuration for which routes can attach"
      }
    },
    "additionalProperties": false,
    "description": "Configuration for `gateway.main`.",
    "default": {}
  },
  "description": "Configuration for `gateway`."
}
