    "logLevel": {
      "type": "string",
      "description": "The cluster log level. Available values: - `error`"
    },
    "certificates": {
      "allOf": [
        {
          "$ref": "cluster/certificates.json"
        }
      ],
      "description": "TODO ---"
    },
    "postgresql": {
      "allOf": [
        {
          "$ref": "cluster/postgresql.json"
        }
      ],
      "description": "TODO ---"
    },
    "initdb": {
      "allOf": [
        {
          "$ref": "cluster/initdb.json"
        }
      ],
      "description": "TODO ---"
    }
