{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the listener, unique within the Gateway.",
      "minLength": 1
    },
    "hostname": {
      "type": [
        "null",
        "string"
      ],
      "description": "Hostname of the listener, supports Helm `tpl`.",
      "x-helm-tpl": true
    },
    "port": {
      "type": "integer",
      "description": "Port of the listener.",
      "minimum": 1
    },
    "protocol": {
      "type": "string",
      "enum": [
        "HTTP",
        "HTTPS",
        "TCP",
        "TLS",
        "UDP"
      ],
      "description": "Protocol of the listener, eg `HTTP`, `HTTPS`, `TLS`, `TCP` or `UDP`."
    },
    "tls": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "Terminate",
            "Passthrough"
          ],
          "description": "TLS mode, `Terminate` or `Passthrough`."
        },
        "certificateRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "description": "API group of the certificate, `\"\"` for a Secret."
              },
              "kind": {
                "type": "string",
                "description": "Kind of the certificate, eg `Secret`."
              },
              "name": {
                "type": "string",
                "description": "Name of the certificate.",
                "minLength": 1
              },
              "namespace": {
                "type": [
                  "null",
                  "string"
                ],
                "description": "Namespace of the certificate."
              }
            },
            "additionalProperties": false,
            "description": "A reference to a certificate Secret."
          },
          "description": "Certificates of the listener."
        },
        "options": {
          "type": "object",
          "description": "Implementation specific TLS options. Passed as is.",
          "additionalProperties": {
            "description": "A setting passed on as is."
          }
        }
      },
      "additionalProperties": false,
      "description": "TLS settings of the listener."
    },
    "allowedRoutes": {
      "type": "object",
      "properties": {
        "namespaces": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "All",
                "Same",
                "Selector"
              ],
              "description": "Where routes can attach from: `All`, `Same` or `Selector`.",
              "default": "Same"
            },
            "selector": {
              "allOf": [
                {
                  "$ref": "special/labelSelector.json"
                }
              ],
              "description": "Namespaces routes can attach from, by labels, with `from: Selector`."
            }
          },
          "additionalProperties": false,
          "description": "Namespaces routes can attach from."
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "description": "API group of the kind."
              },
              "kind": {
                "type": "string",
                "description": "Kind of the route, eg `HTTPRoute`.",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "description": "A route kind that can attach."
          },
          "description": "Route kinds that can attach."
        }
      },
      "additionalProperties": false,
      "description": "Routes that can attach to the listener."
    }
  },
  "additionalProperties": false,
  "description": "A listener of a Gateway or ListenerSet."
}
