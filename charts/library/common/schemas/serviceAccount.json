{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "targetSelector": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Create serviceAccount objects",
        "default": []
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enables or Disables the serviceAccount",
        "default": false
      },
      "primary": {
        "type": "boolean",
        "description": "Sets the serviceAccount as primary",
        "default": false
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": ""
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for service account",
        "type": [
          "object",
          "string"
        ],
        "default": {}
      },
      "annotations": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": true,
        "description": "Additional annotations for service account",
        "default": {}
      },
      "targetSelectAll": {
        "type": "boolean",
        "description": "Whether to assign the serviceAccount to all pods or not"
      }
    },
    "additionalProperties": true,
    "description": "Define serviceAccount"
  },
  "description": "Create serviceAccount objects"
}
