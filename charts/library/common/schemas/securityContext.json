{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "container": {
      "type": "object",
      "properties": {
        "runAsUser": {
          "type": "integer"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "privileged": {
          "type": "boolean"
        },
        "seccompProfile": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "add": {
              "type": "array"
            },
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "disableS6Caps": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "PUID": {
          "type": "integer"
        },
        "UMASK": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "pod": {
      "type": "object",
      "properties": {
        "fsGroup": {
          "type": "integer"
        },
        "fsGroupChangePolicy": {
          "type": "string"
        },
        "supplementalGroups": {
          "type": "array"
        },
        "sysctls": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
