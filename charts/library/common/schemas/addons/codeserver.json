{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": [
        "boolean",
        "string"
      ],
      "default": false,
      "description": "Enable the code-server addon."
    },
    "targetSelector": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Workloads to which the code-server addon is attached. Defaults to `main`."
    },
    "container": {
      "allOf": [
        {
          "$ref": "container.json"
        },
        {
          "type": "object",
          "properties": {
            "env": {
              "$ref": "codeserver/container/env.json"
            }
          }
        }
      ]
    },
    "service": {
      "$ref": "../service/service.json#/additionalProperties"
    },
    "ingress": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "../ingress/ingress.json#/additionalProperties"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "$ref": "../ingress/ingress.json#/additionalProperties/properties/enabled"
            }
          },
          "additionalProperties": {
            "$ref": "../ingress/ingress.json#/additionalProperties"
          },
          "description": "Named Ingress objects of the code-server addon, next to `enabled`."
        }
      ],
      "description": "Ingress of the code-server addon. Either one Ingress object, or named Ingress objects next to `enabled`."
    }
  },
  "additionalProperties": false,
  "description": "Configuration for the code-server addon."
}
