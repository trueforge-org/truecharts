{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "../../../workload/podSpec/containers/env.json"
    }
  ],
  "description": "Environment variables for codeserver addon.",
  "properties": {
    "PORT": {
      "type": "integer",
      "description": "Code-server port.",
      "default": 12321
    },
    "DEFAULT_WORKSPACE": {
      "type": "string",
      "description": "Default workspace path.",
      "default": "/"
    }
  },
  "x-docs-extends": "workload.$name.podSpec.containers.$name.env"
}
