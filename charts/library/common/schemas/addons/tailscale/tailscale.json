{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Addons to the workloads"
    },
    "targetSelector": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Configuration for `addons.tailscale.targetSelector.$item`."
      },
      "description": "Addons to the workloads"
    },
    "container": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "Enable the container of the add-on."
        },
        "imageSelector": {
          "type": "string",
          "description": "Name of the image on the root of the values."
        },
        "probes": {
          "type": "object",
          "properties": {
            "liveness": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": [
                    "boolean",
                    "string"
                  ],
                  "description": "Enable the container of the add-on."
                }
              },
              "additionalProperties": false,
              "description": "The liveness probe."
            },
            "readiness": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": [
                    "boolean",
                    "string"
                  ],
                  "description": "Enable the container of the add-on."
                }
              },
              "additionalProperties": false,
              "description": "The readiness probe."
            },
            "startup": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": [
                    "boolean",
                    "string"
                  ],
                  "description": "Enable the container of the add-on."
                }
              },
              "additionalProperties": false,
              "description": "The startup probe."
            }
          },
          "additionalProperties": false,
          "description": "Probes of the container."
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Configuration for `addons.tailscale.container.command.$item`."
          },
          "description": "Command of the container."
        },
        "resources": {
          "type": "object",
          "properties": {
            "excludeExtra": {
              "type": "boolean",
              "description": "Leave out the extra resources, like GPUs, of the chart."
            }
          },
          "additionalProperties": false,
          "description": "Resources of the container."
        },
        "env": {
          "$ref": "container/env.json",
          "description": "Environment variables of the container, keyed by name."
        },
        "securityContext": {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "object",
              "properties": {
                "add": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "Configuration for `addons.tailscale.container.securityContext.capabilities.add.$item`."
                  },
                  "description": "Capabilities that are added."
                }
              },
              "additionalProperties": false,
              "description": "Linux capabilities of the container."
            }
          },
          "additionalProperties": false,
          "description": "Security context of the container."
        }
      },
      "additionalProperties": false,
      "description": "Addons to the workloads"
    },
    "settings": {
      "type": "object",
      "properties": {
        "config": {
          "type": "string",
          "description": "Path of a tailscaled config file."
        },
        "authkey": {
          "type": "string",
          "description": "The Tailscale auth key. It is stored in a secret and loaded from there into the `TS_AUTH_KEY` environment variable of the container."
        },
        "userspace": {
          "type": "boolean",
          "description": "Run tailscale in userspace networking mode."
        },
        "auth_once": {
          "type": "boolean",
          "description": "Only log in when the node is not logged in yet."
        },
        "accept_dns": {
          "type": "boolean",
          "description": "Accept the DNS settings of the tailnet."
        },
        "routes": {
          "type": "string",
          "description": "Subnet routes that are advertised, comma separated."
        },
        "dest_ip": {
          "type": "string",
          "description": "IP that the traffic is forwarded to."
        },
        "sock5_server": {
          "type": "string",
          "description": "Address of a SOCKS5 proxy, eg `:1080`."
        },
        "extra_args": {
          "type": "string",
          "description": "Extra arguments of `tailscale up`."
        },
        "daemon_extra_args": {
          "type": "string",
          "description": "Extra arguments of `tailscaled`."
        },
        "outbound_http_proxy_listen": {
          "type": "string",
          "description": "Address of an outbound HTTP proxy, eg `:1055`."
        }
      },
      "additionalProperties": false,
      "description": "Tailscale settings"
    },
    "annotations": {
      "allOf": [
        {
          "$ref": "../../special/annotations.json"
        }
      ],
      "description": "Additional annotations, keyed by name."
    }
  },
  "additionalProperties": false,
  "description": "Addons to the workloads"
}
