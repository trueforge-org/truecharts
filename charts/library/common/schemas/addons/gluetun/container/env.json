{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "allOf": [
    {
      "$ref": "../../../workload/podSpec/containers/env.json"
    }
  ],
  "description": "Environment variables for gluetun addon.",
  "properties": {
    "DOT": {
      "type": "string",
      "description": "DNS over TLS provider setting.",
      "default": "off"
    },
    "DNS_KEEP_NAMESERVER": {
      "type": [
        "boolean",
        "string"
      ],
      "description": "Keep nameserver from host.",
      "default": "on"
    },
    "FIREWALL": {
      "type": "string",
      "description": "Firewall mode.",
      "default": "off"
    },
    "FIREWALL_OUTBOUND_SUBNETS": {
      "type": "string",
      "description": "Allowed outbound subnets.",
      "default": ""
    },
    "FIREWALL_INPUT_PORTS": {
      "type": "string",
      "description": "Allowed inbound ports.",
      "default": ""
    }
  },
  "x-docs-extends": "workload.$name.podSpec.containers.$name.env"
}
