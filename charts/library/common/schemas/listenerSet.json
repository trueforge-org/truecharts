{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enables or Disables the ListenerSet",
        "default": false
      },
      "expandObjectName": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Prefix the object name with the chart fullname",
        "default": true
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": ""
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels for ListenerSet",
        "type": [
          "object",
          "string"
        ],
        "default": {}
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Additional annotations for ListenerSet",
        "default": {}
      },
      "targetSelector": {
        "type": [
          "null",
          "string"
        ],
        "description": "Name of a gateway in this chart to attach to. Takes the place of `parentRef`, the gateway must set `allowedListeners.namespaces.from`."
      },
      "parentRef": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string",
            "description": "API group of the parent Gateway.",
            "default": "gateway.networking.k8s.io"
          },
          "kind": {
            "type": "string",
            "description": "Kind of the parent.",
            "default": "Gateway"
          },
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "Name of the parent Gateway, supports Helm `tpl`. Required unless `targetSelector` is set."
          },
          "namespace": {
            "type": [
              "null",
              "string"
            ],
            "description": "Namespace of the parent Gateway, supports Helm `tpl`. Defaults to the namespace of the listener set."
          }
        },
        "additionalProperties": false,
        "description": "The Gateway to attach to, when `targetSelector` is not used."
      },
      "listeners": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Configuration for `listenerSet.main.listeners.$item.name`.",
              "minLength": 1
            },
            "hostname": {
              "type": [
                "null",
                "string"
              ],
              "description": "Hostname of the listener, supports Helm `tpl`."
            },
            "port": {
              "type": "integer",
              "description": "Configuration for `listenerSet.main.listeners.$item.port`.",
              "minimum": 1
            },
            "protocol": {
              "type": "string",
              "enum": [
                "HTTP",
                "HTTPS",
                "TCP",
                "TLS",
                "UDP"
              ],
              "description": "Configuration for `listenerSet.main.listeners.$item.protocol`."
            },
            "tls": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "Terminate",
                    "Passthrough"
                  ],
                  "description": "Configuration for `listenerSet.main.listeners.$item.tls.mode`."
                },
                "certificateRefs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string",
                        "description": "Configuration for `listenerSet.main.listeners.$item.tls.certificateRefs.$item.group`."
                      },
                      "kind": {
                        "type": "string",
                        "description": "Configuration for `listenerSet.main.listeners.$item.tls.certificateRefs.$item.kind`."
                      },
                      "name": {
                        "type": "string",
                        "description": "Configuration for `listenerSet.main.listeners.$item.tls.certificateRefs.$item.name`.",
                        "minLength": 1
                      },
                      "namespace": {
                        "type": [
                          "null",
                          "string"
                        ],
                        "description": "Configuration for `listenerSet.main.listeners.$item.tls.certificateRefs.$item.namespace`."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Configuration for `listenerSet.main.listeners.$item.tls.certificateRefs.$item`."
                  },
                  "description": "Configuration for `listenerSet.main.listeners.$item.tls.certificateRefs`."
                },
                "options": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Implementation specific TLS options. Passed as is."
                }
              },
              "additionalProperties": false,
              "description": "Configuration for `listenerSet.main.listeners.$item.tls`."
            },
            "allowedRoutes": {
              "type": "object",
              "properties": {
                "namespaces": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "enum": [
                        "All",
                        "Same",
                        "Selector"
                      ],
                      "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes.namespaces.from`.",
                      "default": "Same"
                    },
                    "selector": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": false,
                      "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes.namespaces.selector`."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes.namespaces`."
                },
                "kinds": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string",
                        "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes.kinds.$item.group`."
                      },
                      "kind": {
                        "type": "string",
                        "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes.kinds.$item.kind`.",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false,
                    "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes.kinds.$item`."
                  },
                  "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes.kinds`."
                }
              },
              "additionalProperties": false,
              "description": "Configuration for `listenerSet.main.listeners.$item.allowedRoutes`."
            }
          },
          "additionalProperties": false,
          "description": "Configuration for `listenerSet.main.listeners.$item`."
        },
        "description": "Listeners that are added to the Gateway, same format as `gateway.$name.listeners`.",
        "minItems": 1
      }
    },
    "additionalProperties": false,
    "description": "Define ListenerSet",
    "default": {}
  },
  "description": "Create Gateway API ListenerSet objects"
}
