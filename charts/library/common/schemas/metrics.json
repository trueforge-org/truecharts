{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enable the metrics object.",
        "default": false
      },
      "primary": {
        "type": "boolean",
        "description": "Make this the primary metrics object."
      },
      "type": {
        "type": "string",
        "enum": [
          "servicemonitor",
          "podmonitor"
        ],
        "description": "Type of the monitor, `servicemonitor` or `podmonitor`.",
        "default": "servicemonitor"
      },
      "selector": {
        "type": [
          "object",
          "string"
        ],
        "properties": {
          "matchLabels": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "type": "string",
              "description": "Value of the label"
            },
            "description": "Match by labels."
          },
          "matchExpressions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Label key the selector applies to."
                },
                "operator": {
                  "type": "string",
                  "description": "Relationship of the key to the values, e.g. `In`, `NotIn`, `Exists` or `DoesNotExist`."
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Values of the label. Empty for `Exists` and `DoesNotExist`."
                }
              },
              "additionalProperties": false
            },
            "description": "Match by label expressions."
          }
        },
        "additionalProperties": false,
        "description": "Labels that select the service or pods, instead of `targetSelector`.",
        "default": {}
      },
      "matchLabels": {
        "type": [
          "object",
          "string"
        ],
        "additionalProperties": {
          "type": "string"
        },
        "description": "Labels that select the service or pods."
      },
      "endpoints": {
        "type": [
          "array",
          "string"
        ],
        "items": {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "description": "Name of the port that is scraped."
            },
            "interval": {
              "type": "string",
              "description": "Interval between scrapes, eg `30s`."
            },
            "scrapeTimeout": {
              "type": "string",
              "description": "Timeout of a scrape, eg `10s`."
            },
            "path": {
              "type": "string",
              "description": "HTTP path that is scraped."
            },
            "honorLabels": {
              "type": "boolean",
              "description": "Keep the labels of the scraped metrics when they conflict with the labels of the target."
            },
            "scheme": {
              "type": "string",
              "description": "Scheme of the scrape request, `http` or `https`."
            },
            "params": {
              "type": "object",
              "properties": {},
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Values of the query parameter"
              },
              "description": "Query parameters of the scrape request, keyed by name. Supports Helm `tpl`.",
              "x-helm-tpl": true
            },
            "tlsConfig": {
              "type": "object",
              "description": "TLS settings of the scrape request, passed on as is.",
              "additionalProperties": {
                "description": "A setting passed on as is."
              }
            },
            "relabelings": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "A relabel config, passed on as is.",
                "additionalProperties": {
                  "description": "A setting passed on as is."
                }
              },
              "description": "Relabelings applied before scraping. Supports Helm `tpl`.",
              "x-helm-tpl": true
            },
            "metricRelabelings": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "A relabel config, passed on as is.",
                "additionalProperties": {
                  "description": "A setting passed on as is."
                }
              },
              "description": "Relabelings applied to the scraped metrics. Supports Helm `tpl`.",
              "x-helm-tpl": true
            }
          },
          "additionalProperties": false,
          "description": "Configuration for `metrics.main.endpoints.$item`."
        },
        "description": "Endpoints that are scraped."
      },
      "prometheusRule": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "string"
            ],
            "description": "Create a PrometheusRule for this metrics object. Nothing is created when there are no rules."
          },
          "labels": {
            "allOf": [
              {
                "$ref": "special/labels.json"
              }
            ],
            "description": "Labels of the PrometheusRule. They take precedence over the `labels` of the metrics object."
          },
          "annotations": {
            "allOf": [
              {
                "$ref": "special/annotations.json"
              }
            ],
            "description": "Annotations of the PrometheusRule. They take precedence over the `annotations` of the metrics object."
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/additionalProperties/properties/prometheusRule/properties/groups/additionalProperties/properties/rules/items"
            },
            "description": "Rules of a group named after the PrometheusRule. Use `groups` for more than one group."
          },
          "groups": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the group. Defaults to the key."
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "alert": {
                        "type": "string",
                        "description": "Name of the alert rule."
                      },
                      "record": {
                        "type": "string",
                        "description": "Name of the recording rule."
                      },
                      "expr": {
                        "type": "string",
                        "description": "PromQL expression to evaluate."
                      },
                      "for": {
                        "type": "string",
                        "description": "Duration the expression must be true before the alert fires."
                      },
                      "keep_firing_for": {
                        "type": "string",
                        "description": "Duration the alert keeps firing after the expression is no longer true."
                      },
                      "labels": {
                        "allOf": [
                          {
                            "$ref": "special/labels.json"
                          }
                        ],
                        "description": "Labels added to the alert or recording rule."
                      },
                      "annotations": {
                        "allOf": [
                          {
                            "$ref": "special/annotations.json"
                          }
                        ],
                        "description": "Annotations added to the alert or recording rule."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Configuration for `metrics.main.prometheusRule.groups.$name.rules.$item`."
                  },
                  "description": "Rules of the group."
                },
                "additionalrules": {
                  "type": "array",
                  "description": "Additional rules of the group, next to `rules`.",
                  "items": {
                    "$ref": "#/additionalProperties/properties/prometheusRule/properties/groups/additionalProperties/properties/rules/items"
                  }
                }
              },
              "additionalProperties": false,
              "description": "Configuration for `metrics.main.prometheusRule.groups.$name`."
            },
            "description": "Groups of rules, keyed by name.",
            "default": {}
          },
          "additionalgroups": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Name of the group. Defaults to the key."
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "alert": {
                            "type": "string",
                            "description": "Name of the alert."
                          },
                          "expr": {
                            "type": "string",
                            "description": "PromQL expression."
                          },
                          "for": {
                            "type": "string",
                            "description": "How long the expression has to be true before the alert fires."
                          }
                        },
                        "additionalProperties": false,
                        "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.rules.$item`."
                      },
                      "description": "Rules of the group."
                    },
                    "additionalrules": {
                      "type": "array",
                      "description": "Additional rules of the group, next to `rules`."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item`."
                }
              },
              {
                "type": "null"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              }
            ],
            "description": "Additional groups of rules, as a list."
          }
        },
        "additionalProperties": false,
        "description": "A PrometheusRule with alerting and recording rules.",
        "default": "{ enabled: false }"
      },
      "targetSelector": {
        "type": "string",
        "description": "Service or workload the monitor selects. Defaults to the primary one."
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Additional labels, keyed by name."
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "special/annotations.json"
          }
        ],
        "description": "Additional annotations, keyed by name."
      },
      "nameOverride": {
        "type": "string",
        "description": "Suffix of the name, instead of the name of the object."
      },
      "apiKey": {
        "type": "string",
        "description": "API key the exporter needs."
      }
    },
    "additionalProperties": false,
    "description": "Configuration for `metrics.main`.",
    "default": {}
  },
  "description": "Configuration for `metrics`."
}
