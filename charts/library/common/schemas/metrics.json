{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Configuration for `metrics.main.enabled`.",
        "default": false
      },
      "primary": {
        "type": "boolean",
        "description": "Configuration for `metrics.main.primary`."
      },
      "type": {
        "type": "string",
        "enum": [
          "servicemonitor",
          "podmonitor"
        ],
        "description": "Configuration for `metrics.main.type`.",
        "default": "servicemonitor"
      },
      "selector": {
        "type": [
          "object",
          "string"
        ],
        "properties": {},
        "additionalProperties": false,
        "description": "Configuration for `metrics.main.selector`.",
        "default": {}
      },
      "matchLabels": {
        "type": [
          "object",
          "string"
        ],
        "additionalProperties": {
          "type": "string"
        },
        "description": "Configuration for `metrics.main.matchLabels`. Set in common-test fixtures and ignored by the common ServiceMonitor and PodMonitor templates, which build their own matchLabels; use `selector` to set matchers."
      },
      "endpoints": {
        "type": [
          "array",
          "string"
        ],
        "items": {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "description": "Configuration for `metrics.main.endpoints.$item.port`."
            },
            "interval": {
              "type": "string",
              "description": "Configuration for `metrics.main.endpoints.$item.interval`."
            },
            "scrapeTimeout": {
              "type": "string",
              "description": "Configuration for `metrics.main.endpoints.$item.scrapeTimeout`."
            },
            "path": {
              "type": "string",
              "description": "Configuration for `metrics.main.endpoints.$item.path`."
            },
            "honorLabels": {
              "type": "boolean",
              "description": "Configuration for `metrics.main.endpoints.$item.honorLabels`."
            }
          },
          "additionalProperties": false,
          "description": "Configuration for `metrics.main.endpoints.$item`."
        },
        "description": "Configuration for `metrics.main.endpoints`."
      },
      "prometheusRule": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "string"
            ],
            "description": "Configuration for `metrics.main.prometheusRule.enabled`."
          },
          "labels": {
            "allOf": [
              {
                "$ref": "special/labels.json"
              }
            ],
            "description": "Configuration for `metrics.main.prometheusRule.labels`. Set by stable charts (blocky, grafana, ntfy, kubelet-csr-approver), but the common PrometheusRule template ignores it; use `metrics.main.labels`."
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false
            },
            "description": "Configuration for `metrics.main.prometheusRule.rules`. Set by stable charts (blocky, grafana, ntfy), but the common PrometheusRule template ignores it; use `groups` or `additionalgroups` for rules."
          },
          "groups": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Configuration for `metrics.main.prometheusRule.groups.$name.name`. Overrides the group name, which defaults to the key."
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "alert": {
                        "type": "string",
                        "description": "Name of the alert rule."
                      },
                      "record": {
                        "type": "string",
                        "description": "Name of the recording rule."
                      },
                      "expr": {
                        "type": "string",
                        "description": "PromQL expression to evaluate."
                      },
                      "for": {
                        "type": "string",
                        "description": "Duration the expression must be true before the alert fires."
                      },
                      "keep_firing_for": {
                        "type": "string",
                        "description": "Duration the alert keeps firing after the expression is no longer true."
                      },
                      "labels": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": {
                          "type": "string",
                          "description": "Value of the label"
                        },
                        "description": "Labels added to the alert or recording rule."
                      },
                      "annotations": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": {
                          "type": "string",
                          "description": "Value of the annotation"
                        },
                        "description": "Annotations added to the alert or recording rule."
                      }
                    },
                    "additionalProperties": false,
                    "description": "Configuration for `metrics.main.prometheusRule.groups.$name.rules.$item`."
                  },
                  "description": "Configuration for `metrics.main.prometheusRule.groups.$name.rules`."
                },
                "additionalrules": {
                  "type": "array",
                  "description": "Configuration for `metrics.main.prometheusRule.groups.$name.additionalrules`. Rules added via the SCALE GUI without overwriting `rules`."
                }
              },
              "additionalProperties": false,
              "description": "Configuration for `metrics.main.prometheusRule.groups.$name`."
            },
            "description": "Configuration for `metrics.main.prometheusRule.groups`. Each key is the name of a group.",
            "default": {}
          },
          "additionalgroups": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.name`."
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "alert": {
                            "type": "string",
                            "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.rules.$item.alert`."
                          },
                          "expr": {
                            "type": "string",
                            "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.rules.$item.expr`."
                          },
                          "for": {
                            "type": "string",
                            "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.rules.$item.for`."
                          }
                        },
                        "additionalProperties": false,
                        "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.rules.$item`."
                      },
                      "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.rules`."
                    },
                    "additionalrules": {
                      "type": "array",
                      "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item.additionalrules`."
                    }
                  },
                  "additionalProperties": false,
                  "description": "Configuration for `metrics.main.prometheusRule.additionalgroups.$item`."
                }
              },
              {
                "type": "null"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "object"
              }
            ],
            "description": "Configuration for `metrics.main.prometheusRule.additionalgroups`."
          }
        },
        "additionalProperties": false,
        "description": "Configuration for `metrics.main.prometheusRule`.",
        "default": "{ enabled: false }"
      },
      "targetSelector": {
        "type": "string",
        "description": "Configuration for `metrics.main.targetSelector`."
      },
      "labels": {
        "allOf": [
          {
            "$ref": "special/labels.json"
          }
        ],
        "description": "Configuration for `metrics.main.labels`."
      },
      "annotations": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "Configuration for `metrics.main.annotations`."
      },
      "nameOverride": {
        "type": "string",
        "description": "Configuration for `metrics.main.nameOverride`."
      },
      "apiKey": {
        "type": "string",
        "description": "Configuration for `metrics.main.apiKey`. Read by stable charts (sabnzbd, bazarr) through their own metrics values, not by the common templates."
      }
    },
    "additionalProperties": false,
    "description": "Configuration for `metrics.main`.",
    "default": {}
  },
  "description": "Configuration for `metrics`."
}
