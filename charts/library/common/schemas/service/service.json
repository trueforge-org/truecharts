{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {},
  "additionalProperties": {
    "type": "object",
    "properties": {
      "integrations": {
        "type": "object",
        "properties": {
          "metallb": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enables or Disables the MetalLB integration",
                "default": false
              },
              "sharedKey": {
                "type": "string",
                "description": "Sets the shared key in `metallb.io/allow-shared-ip` **MetalLB** Annotation. Defaults to the namespace. Mutually exclusive with `externalTrafficPolicy: Local`",
                "default": ""
              }
            },
            "additionalProperties": false,
            "description": "Define the MetalLB integration, only applies to `type: LoadBalancer`",
            "default": {}
          },
          "cilium": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Enables or Disables the Cilium integration",
                "default": false
              },
              "sharedKey": {
                "type": "string",
                "description": "Sets the shared key in `lbipam.cilium.io/sharing-key` **Cilium** Annotation. Mutually exclusive with `externalTrafficPolicy: Local`",
                "default": ""
              }
            },
            "additionalProperties": false,
            "description": "Define the Cilium integration (LB-IPAM), only applies to `type: LoadBalancer`",
            "default": {}
          },
          "traefik": {
            "allOf": [
              {
                "$ref": "integrations/traefik.json"
              }
            ],
            "description": "Define service objects",
            "type": "object",
            "default": {}
          }
        },
        "additionalProperties": false,
        "description": "Define the integrations for this service",
        "default": {}
      },
      "externalName": {
        "allOf": [
          {
            "$ref": "ExternalName.json"
          }
        ],
        "description": "Configure ExternalName type",
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "ports": {
        "type": "object",
        "properties": {},
        "additionalProperties": {
          "$ref": "ports.json",
          "x-docs-required": true
        },
        "description": "Define the ports of the service See [Ports](/truecharts-common/service/ports)",
        "default": {},
        "x-docs-required": true
      },
      "sharedKey": {
        "type": "string",
        "description": "Sets the shared key in `metallb.io/allow-shared-ip` **MetalLB** Annotation",
        "x-helm-tpl": true
      },
      "loadBalancerIP": {
        "type": "string",
        "description": "Define the load balancer IP, sets the `metallb.io/loadBalancerIPs` **MetalLB** annotation. Mutually exclusive with `loadBalancerIPs`",
        "x-helm-tpl": true
      },
      "loadBalancerIPs": {
        "type": "array",
        "description": "Define the load balancer IPs, sets the `metallb.io/loadBalancerIPs` **MetalLB** annotation. Mutually exclusive with `loadBalancerIP`",
        "x-helm-tpl": "On entries only"
      },
      "loadBalancerSourceRanges": {
        "type": "array",
        "description": "Define the load balancer source ranges",
        "x-helm-tpl": "On entries only"
      },
      "allocateLoadBalancerNodePorts": {
        "type": "boolean",
        "description": "Define whether to allocate NodePorts for the service, only applies to `type: LoadBalancer`",
        "default": false
      },
      "externalIP": {
        "allOf": [
          {
            "$ref": "ExternalIP.json"
          }
        ],
        "description": "Configure External IP type",
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "useSlice": {
        "type": [
          "boolean",
          "object"
        ],
        "description": "Define whether to use `EndpointSlice` or `Endpoint`"
      },
      "addressType": {
        "type": "string",
        "description": "Define the addressType for External IP",
        "x-helm-tpl": true
      },
      "appProtocol": {
        "type": "string",
        "description": "Define the appProtocol for External IP",
        "x-helm-tpl": true
      },
      "enabled": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Enables or Disables the service",
        "default": false,
        "x-helm-tpl": true,
        "x-docs-required": true
      },
      "namespace": {
        "allOf": [
          {
            "$ref": "../special/namespaces.json"
          }
        ],
        "description": "Define the namespace for this object",
        "default": "",
        "x-helm-tpl": "On value only"
      },
      "labels": {
        "allOf": [
          {
            "$ref": "../special/labels.json"
          }
        ],
        "description": "Additional labels for service",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "annotationsList": {
        "allOf": [
          {
            "$ref": "../special/annotationsList.json"
          }
        ],
        "description": "Additional annotations as a list of name and value pairs, merged into the annotations"
      },
      "labelsList": {
        "allOf": [
          {
            "$ref": "../special/labelsList.json"
          }
        ],
        "description": "Additional labels as a list of name and value pairs, merged into the labels"
      },
      "annotations": {
        "allOf": [
          {
            "$ref": "../special/annotations.json"
          }
        ],
        "description": "Additional annotations for service",
        "default": {},
        "x-helm-tpl": "On value only"
      },
      "type": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "ClusterIP",
              "LoadBalancer",
              "NodePort",
              "ExternalName",
              "ExternalIP"
            ]
          },
          {
            "type": "string",
            "pattern": "^\\{\\{.*\\}\\}$"
          }
        ],
        "description": "Define the service type",
        "x-helm-tpl": true
      },
      "expandObjectName": {
        "type": [
          "boolean",
          "string"
        ],
        "description": "Whether to expand the object name (based on the [naming scheme](/truecharts-common/service#naming-scheme)) or not",
        "default": true,
        "x-helm-tpl": true
      },
      "clusterIP": {
        "allOf": [
          {
            "$ref": "ClusterIP.json"
          }
        ],
        "description": "Configure Cluster IP type",
        "default": "",
        "x-helm-tpl": true
      },
      "ipFamilyPolicy": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "SingleStack",
              "PreferDualStack",
              "RequireDualStack"
            ]
          },
          {
            "type": "string",
            "pattern": "^\\{\\{.*\\}\\}$"
          }
        ],
        "description": "Define the ipFamilyPolicy Does **not** apply to `type` of `ExternalName` or `ExternalIP`",
        "default": "",
        "x-helm-tpl": true
      },
      "ipFamilies": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Define the ipFamilies Does **not** apply to `type` of `ExternalName` or `ExternalIP`",
        "default": [],
        "x-helm-tpl": "On entries only"
      },
      "sessionAffinity": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "ClientIP",
              "None"
            ]
          },
          {
            "type": "string",
            "pattern": "^\\{\\{.*\\}\\}$"
          }
        ],
        "description": "Define the session affinity (ClientIP, None)",
        "default": "",
        "x-helm-tpl": true
      },
      "sessionAffinityConfig": {
        "type": "object",
        "properties": {
          "clientIP": {
            "type": "object",
            "properties": {
              "timeoutSeconds": {
                "type": [
                  "integer",
                  "string"
                ],
                "description": "Define the timeout for ClientIP session affinity (0-86400)",
                "default": "",
                "x-helm-tpl": true
              }
            },
            "additionalProperties": false,
            "description": "Session affinity by client IP."
          }
        },
        "additionalProperties": false,
        "description": "Settings of the session affinity."
      },
      "externalIPs": {
        "type": [
          "array",
          "string"
        ],
        "items": {
          "type": "string"
        },
        "description": "Define externalIPs",
        "default": [],
        "x-helm-tpl": "On entries only"
      },
      "externalTrafficPolicy": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "Cluster",
              "Local"
            ]
          },
          {
            "type": "string",
            "pattern": "^\\{\\{.*\\}\\}$"
          }
        ],
        "description": "Define the external traffic policy (Cluster, Local) Does **not** apply to `type` of `ClusterIP`",
        "default": "",
        "x-helm-tpl": true
      },
      "publishNotReadyAddresses": {
        "type": "boolean",
        "description": "Define whether to publishNotReadyAddresses or not",
        "default": false
      },
      "targetSelector": {
        "type": "string",
        "description": "Define the pod to link the service, by default will use the primary pod",
        "default": ""
      },
      "selectorLabels": {
        "allOf": [
          {
            "$ref": "../special/labels.json"
          }
        ],
        "type": "object",
        "description": "Define the labels used as the selector of the service, replaces the default selector labels",
        "default": {}
      },
      "primary": {
        "type": "boolean",
        "description": "Make this the primary service."
      }
    },
    "additionalProperties": false,
    "description": "Define service",
    "default": {},
    "x-docs-required": true
  },
  "description": "Define service objects"
}
